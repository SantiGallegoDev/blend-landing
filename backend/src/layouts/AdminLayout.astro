---
import '../styles/admin.css';
import { and, eq, inArray } from 'drizzle-orm';
import logo from '../assets/logo-blend.svg';
import Icon, { type IconName } from '../components/Icon.astro';
import { db, schema } from '../db';
import { env } from '../env';
import { roleLabel } from '../lib/format';
import { can } from '../lib/guard';
import { publishState } from '../lib/publish';

interface Props {
  title: string;
  // Pantallas sin menú: login, activación de 2FA, invitación.
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname.replace(/\/$/, '');

type Item = { href: string; label: string; icon: IconName; show: boolean; count?: number };
const toShip = !bare && can(user?.role, 'pedidos')
  ? await db.$count(schema.order, and(eq(schema.order.status, 'paid'), inArray(schema.order.fulfillment, ['pending', 'preparing'])))
  : 0;

const allGroups: { title: string; items: Item[] }[] = [
  {
    title: 'Tienda',
    items: [
      { href: '/admin', label: 'Inicio', icon: 'home', show: true },
      { href: '/admin/pedidos', label: 'Pedidos', icon: 'bag', show: can(user?.role, 'pedidos'), count: toShip },
      { href: '/admin/productos', label: 'Productos', icon: 'bottle', show: can(user?.role, 'productos') },
      { href: '/admin/inventario', label: 'Inventario', icon: 'layers', show: can(user?.role, 'inventario') },
      { href: '/admin/entregas', label: 'Domicilio', icon: 'truck', show: can(user?.role, 'productos') },
    ],
  },
  {
    title: 'Equipo',
    items: [
      { href: '/admin/alertas', label: 'Alertas', icon: 'bell', show: can(user?.role, 'alertas') },
      { href: '/admin/usuarios', label: 'Usuarios', icon: 'users', show: can(user?.role, 'usuarios') },
      { href: '/admin/actividad', label: 'Actividad', icon: 'activity', show: can(user?.role, 'actividad') },
    ],
  },
];
const groups = allGroups.map((g) => ({ ...g, items: g.items.filter((i) => i.show) })).filter((g) => g.items.length);

const all = groups.flatMap((g) => g.items);
// En el celular: las 4 primeras en la barra inferior y el resto en "Más".
const primary = all.slice(0, 4);
const secondary = all.slice(4);

const isCurrent = (href: string) => (href === '/admin' ? path === href : path === href || path.startsWith(href + '/'));
const moreActive = secondary.some((i) => isCurrent(i.href)) || path.startsWith('/admin/cuenta');
const msg = Astro.url.searchParams.get('msg');
const flash = msg ? { ok: Astro.url.searchParams.get('publicado') === '1', message: msg.slice(0, 200) } : null;
const publish = !bare && can(user?.role, 'productos') ? await publishState() : null;
const initials = (user?.name ?? '?').split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
const today = new Intl.DateTimeFormat('es-CO', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'America/Bogota' }).format(new Date());
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#F7F0E6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Blend</title>
  </head>
  <body class:list={[bare ? 'bare' : 'shell']}>
    {bare ? (
      <main class="bare-main">
        <img src={logo.src} alt="Blend" width="120" height="37" class="bare-logo" />
        <slot />
        <p class="bare-foot small">Panel de Blend · acceso protegido</p>
      </main>
    ) : (
      <div class="app">
        <aside class="sidebar" aria-label="Menú del panel">
          <a href="/admin" class="brand">
            <img src={logo.src} alt="Blend" width="92" height="28" />
            <span class="brand-tag">Panel</span>
          </a>

          <nav class="nav">
            {groups.map((g) => (
              <div class="nav-group">
                <p class="nav-title">{g.title}</p>
                {g.items.map((item) => (
                  <a href={item.href} class="nav-link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    <Icon name={item.icon} />
                    <span>{item.label}</span>
                    {item.count ? <span class="nav-count" aria-label={`${item.count} por despachar`}>{item.count}</span> : null}
                  </a>
                ))}
              </div>
            ))}
          </nav>

          <div class="side-foot">
            <a href={env.SITE_ORIGIN} class="nav-link nav-ext" target="_blank" rel="noopener noreferrer">
              <Icon name="globe" />
              <span>Ver la web</span>
              <Icon name="external" size={15} class="ext" />
            </a>
            <div class="me">
              <a href="/admin/cuenta" class="me-link" aria-current={path.startsWith('/admin/cuenta') ? 'page' : undefined}>
                <span class="avatar" aria-hidden="true">{initials}</span>
                <span class="me-text">
                  <strong>{user?.name}</strong>
                  <span>{roleLabel[user?.role ?? ''] ?? ''} · Mi cuenta</span>
                </span>
              </a>
              <form method="post" action="/admin/salir">
                <button type="submit" class="icon-btn" title="Cerrar sesión" aria-label="Cerrar sesión"><Icon name="logout" size={18} /></button>
              </form>
            </div>
          </div>
        </aside>

        <div class="main">
          <header class="topbar">
            <a href="/admin" class="brand brand-mobile"><img src={logo.src} alt="Blend" width="78" height="24" /></a>
            <p class="today">{today}</p>
            <div class="top-actions">
              {publish?.pending && (
                <form method="post" action="/admin/publicar" class="publish" title="Hay cambios del catálogo que la web todavía no muestra">
                  <input type="hidden" name="back" value={path} />
                  <button type="submit" class="publish-btn">
                    <span class="pulse" aria-hidden="true"></span>
                    <Icon name="sparkle" size={16} />
                    <span>Publicar cambios</span>
                  </button>
                </form>
              )}
              <a href="/admin/cuenta" class="avatar avatar-mobile" aria-label="Mi cuenta">{initials}</a>
            </div>
          </header>

          <main class="content">
            {flash && <p class:list={['alert', flash.ok ? 'alert-ok' : 'alert-bad']} role="status">{flash.message}</p>}
            <slot />
          </main>
        </div>

        <nav class="tabbar" aria-label="Menú">
          {primary.map((item) => (
            <a href={item.href} class="tab" aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <span class="tab-icon"><Icon name={item.icon} size={22} />{item.count ? <span class="tab-count">{item.count}</span> : null}</span>
              <span>{item.label}</span>
            </a>
          ))}
          <details class="tab more">
            <summary class:list={['tab-sum', moreActive && 'is-active']}>
              <span class="tab-icon"><Icon name="more" size={22} /></span>
              <span>Más</span>
            </summary>
            <div class="sheet">
              {secondary.map((item) => (
                <a href={item.href} class="nav-link" aria-current={isCurrent(item.href) ? 'page' : undefined}><Icon name={item.icon} /><span>{item.label}</span></a>
              ))}
              <a href="/admin/cuenta" class="nav-link" aria-current={path.startsWith('/admin/cuenta') ? 'page' : undefined}><Icon name="user" /><span>Mi cuenta</span></a>
              <a href={env.SITE_ORIGIN} class="nav-link" target="_blank" rel="noopener noreferrer"><Icon name="globe" /><span>Ver la web</span></a>
              <form method="post" action="/admin/salir"><button type="submit" class="nav-link as-button"><Icon name="logout" /><span>Cerrar sesión</span></button></form>
            </div>
          </details>
        </nav>
      </div>
    )}
  </body>
</html>

<style>
  /* ── Pantallas sin menú (login, 2FA, invitación) ── */
  .bare-main {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    gap: 28px;
    padding: 40px 16px;
    width: min(100%, 440px);
    margin-inline: auto;
  }
  .bare-logo { height: 36px; width: auto; justify-self: center; }
  .bare-main :global(.card) { padding: 32px; box-shadow: var(--shadow-lg); background: var(--glass-strong); }
  .bare-foot { text-align: center; color: var(--ink-3); }

  /* ── Estructura ── */
  .app { min-height: 100dvh; display: grid; grid-template-columns: 1fr; }
  .main { min-width: 0; display: flex; flex-direction: column; }
  @media (min-width: 1024px) {
    .app { grid-template-columns: 272px 1fr; }
  }

  /* ── Barra lateral de vidrio ── */
  .sidebar {
    display: none;
    position: sticky;
    top: 16px;
    height: calc(100dvh - 32px);
    margin: 16px 0 16px 16px;
    padding: 22px 16px 16px;
    flex-direction: column;
    gap: 22px;
    border-radius: 28px;
    background: linear-gradient(180deg, rgba(255, 253, 249, .78), rgba(255, 253, 249, .52));
    -webkit-backdrop-filter: blur(28px) saturate(150%);
    backdrop-filter: blur(28px) saturate(150%);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  /* Brillo suave en el borde superior del vidrio. */
  .sidebar::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 120px;
    background: radial-gradient(120% 100% at 50% 0%, rgba(255, 255, 255, .8), transparent 70%);
    pointer-events: none;
  }
  @media (min-width: 1024px) { .sidebar { display: flex; } }

  .brand { position: relative; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; padding: 0 8px; }
  .brand img { height: 28px; width: auto; }
  .brand-tag {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 999px;
    color: var(--sage-ink);
    background: linear-gradient(135deg, rgba(197, 209, 176, .7), rgba(202, 192, 95, .35));
  }

  .nav { position: relative; display: grid; gap: 18px; overflow-y: auto; scrollbar-width: none; flex: 1; align-content: start; }
  .nav-group { display: grid; gap: 2px; }
  .nav-title { padding: 0 12px 6px; font-size: 11px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 14px;
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 450;
    transition: background .2s var(--ease), color .2s var(--ease), box-shadow .2s var(--ease);
  }
  .nav-link:hover { background: rgba(255, 255, 255, .6); color: var(--ink); }
  .nav-link[aria-current='page'] {
    color: var(--ink);
    background: rgba(255, 255, 255, .92);
    box-shadow: 0 1px 0 #fff inset, 0 8px 20px -12px rgba(42, 37, 32, .35);
  }
  /* Marca de color (degradado de sabores) en la sección activa. */
  .nav-link[aria-current='page']::before {
    content: '';
    position: absolute;
    left: -16px;
    top: 10px;
    bottom: 10px;
    width: 4px;
    border-radius: 0 4px 4px 0;
    background: linear-gradient(180deg, var(--pink), var(--sunset) 55%, var(--detox));
  }
  .nav-count {
    margin-left: auto;
    min-width: 22px;
    padding: 1px 7px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
    color: #fff;
    background: linear-gradient(135deg, var(--pink), var(--sunset));
    box-shadow: 0 4px 10px -4px rgba(220, 73, 129, .6);
  }
  .ext { margin-left: auto; opacity: .5; }

  .side-foot { position: relative; display: grid; gap: 10px; padding-top: 14px; border-top: 1px solid var(--line); }
  .me { display: flex; align-items: center; gap: 6px; padding: 6px; border-radius: 18px; background: rgba(255, 255, 255, .55); border: 1px solid var(--glass-border); }
  .me-link { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10px; text-decoration: none; padding: 4px; border-radius: 12px; }
  .me-link:hover { background: rgba(255, 255, 255, .7); }
  .me-text { min-width: 0; display: grid; line-height: 1.25; }
  .me-text strong { font-weight: 500; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .me-text span { font-size: 12px; color: var(--ink-3); white-space: nowrap; }
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .02em;
    color: #fff;
    text-decoration: none;
    background: linear-gradient(135deg, #E27BA1 0%, #E9A15A 55%, #CFC36C 100%);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, .85), 0 6px 14px -6px rgba(220, 73, 129, .55);
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }
  .icon-btn:hover { background: rgba(255, 255, 255, .8); color: var(--bad); }

  /* ── Barra superior ── */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px clamp(16px, 3vw, 36px);
    background: linear-gradient(180deg, rgba(251, 247, 239, .85), rgba(251, 247, 239, .55));
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    backdrop-filter: blur(18px) saturate(140%);
    border-bottom: 1px solid rgba(42, 37, 32, .05);
  }
  @media (min-width: 1024px) {
    .topbar { position: static; background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; border: 0; padding-top: 26px; padding-bottom: 0; }
    .brand-mobile, .avatar-mobile { display: none !important; }
  }
  .brand-mobile { padding: 0; }
  .brand-mobile img { height: 24px; }
  .today { font-size: 13px; color: var(--ink-3); }
  .today::first-letter { text-transform: uppercase; }
  @media (max-width: 1023px) { .today { display: none; } }
  .top-actions { margin-left: auto; display: flex; align-items: center; gap: 12px; }
  .avatar-mobile { width: 34px; height: 34px; font-size: 12px; }
  .publish-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px 9px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, .6);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    cursor: pointer;
    background: linear-gradient(120deg, #2A2520 0%, #4A3A31 60%, #6B4A3A 100%);
    box-shadow: 0 1px 0 rgba(255, 255, 255, .2) inset, 0 10px 24px -12px rgba(42, 37, 32, .8);
    transition: transform .2s var(--ease), box-shadow .2s var(--ease);
  }
  .publish-btn:hover { transform: translateY(-1px); box-shadow: 0 1px 0 rgba(255, 255, 255, .2) inset, 0 14px 28px -12px rgba(42, 37, 32, .9); }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: #F2B66B; box-shadow: 0 0 0 0 rgba(242, 182, 107, .7); }
  @media (prefers-reduced-motion: no-preference) {
    .pulse { animation: pulse 2s infinite; }
  }
  @keyframes pulse { 70% { box-shadow: 0 0 0 8px rgba(242, 182, 107, 0); } 100% { box-shadow: 0 0 0 0 rgba(242, 182, 107, 0); } }
  @media (max-width: 520px) { .publish-btn span:last-child { display: none; } .publish-btn { padding: 9px 12px; } }

  /* ── Contenido ── */
  .content {
    width: min(100%, 1200px);
    margin-inline: auto;
    padding: 24px clamp(16px, 3vw, 36px) 64px;
    display: grid;
    gap: 22px;
    align-content: start;
  }
  @media (max-width: 1023px) { .content { padding-bottom: 120px; } }

  /* ── Barra inferior (celular) ── */
  .tabbar {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: 30;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    padding: 6px;
    border-radius: 24px;
    background: rgba(255, 253, 249, .78);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 1024px) { .tabbar { display: none; } }
  .tab, .tab-sum {
    display: grid;
    justify-items: center;
    gap: 3px;
    padding: 7px 4px 6px;
    border-radius: 18px;
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-3);
    text-decoration: none;
    list-style: none;
    cursor: pointer;
  }
  .tab-sum::-webkit-details-marker { display: none; }
  .tab[aria-current='page'], .tab-sum.is-active { color: var(--ink); background: rgba(255, 255, 255, .95); box-shadow: 0 6px 16px -10px rgba(42, 37, 32, .45); }
  .tab-icon { position: relative; }
  .tab-count {
    position: absolute;
    top: -6px;
    right: -10px;
    min-width: 17px;
    padding: 0 4px;
    border-radius: 999px;
    font-size: 10px;
    line-height: 17px;
    text-align: center;
    color: #fff;
    background: linear-gradient(135deg, var(--pink), var(--sunset));
  }
  .more { position: relative; padding: 0; }
  .sheet {
    position: absolute;
    right: 0;
    bottom: calc(100% + 14px);
    width: min(280px, calc(100vw - 24px));
    display: grid;
    gap: 2px;
    padding: 10px;
    border-radius: 22px;
    background: rgba(255, 253, 249, .95);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-lg);
  }
  .sheet .nav-link[aria-current='page']::before { display: none; }
  .as-button { width: 100%; border: 0; background: none; font: inherit; cursor: pointer; text-align: left; }
  .as-button:hover { color: var(--bad); }
</style>
