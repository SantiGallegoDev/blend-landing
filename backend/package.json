{
  "name": "blend-backend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4400",
    "build": "astro build",
    "start": "tsx scripts/migrate.ts && node ./dist/server/entry.mjs",
    "check": "astro check",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "create-owner": "tsx scripts/create-owner.ts",
    "seed:catalog": "tsx scripts/seed-catalog.ts",
    "catalog": "tsx scripts/catalog-transfer.ts",
    "email:preview": "tsx scripts/email-preview.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@better-auth/passkey": "^1.7.13",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "astro": "^7.3.8",
    "better-auth": "^1.7.13",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "uqr": "^0.1.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3"
  }
