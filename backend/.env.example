# Copiar a .env para desarrollo. En Railway estas variables van en el servicio.
DATABASE_URL=postgres://blend:blend@localhost:5433/blend

# Orígenes públicos de cada host (sin barra final).
ADMIN_ORIGIN=http://localhost:4400
API_ORIGIN=http://localhost:4400
# Web pública en Vercel (CORS de la API).
SITE_ORIGIN=http://localhost:4321

# 32+ bytes aleatorios: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET=

# En local no hay proxy: se usa X-Forwarded-For. En Railway dejar el valor por defecto (x-real-ip).
CLIENT_IP_HEADER=x-forwarded-for

# Correo (Resend). Sin RESEND_API_KEY los correos se muestran en la consola.
RESEND_API_KEY=
MAIL_FROM="Blend <no-responder@blend.local>"
# Aviso de pedidos pagados al equipo.
ORDERS_NOTIFY_EMAIL=

# Archivos. Sin S3_BUCKET se guardan en ./storage (solo desarrollo).
STORAGE_DIR=./storage
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Mercado Pago (API de Orders). Vacío = pagos apagados (el checkout responde 503).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Botón "Publicar en la web" (Vercel → Settings → Git → Deploy Hooks).
VERCEL_DEPLOY_HOOK_URL=
