---
import { rituals } from '../data/site';
const [r0, r1, r2, r3] = rituals;
---
<section class="section-tight" id="rituales">
  <div class="eyebrow" data-reveal="fade-up">Rituales suaves</div>
  <h2 class="h-section-sm" style="margin-bottom: clamp(28px, 5vw, 50px);" data-reveal="fade-up">
    maneras pequeñas de <span class="accent">quererte.</span>
  </h2>

  <div class="rituals-grid" data-reveal-grid>
    <!-- Left big tile: desayuno lento -->
    <div class="img img-cream rit-tile rit-big">
      <img src={r0.photo} alt={r0.alt} class="img-fill" loading="lazy" decoding="async" />
      <div class="rit-shade"></div>
      <div class="rit-chip-tl">
        <span class="chip"><span class={`dot ${r0.dot}`}></span>{r0.time}</span>
      </div>
      <div class="rit-bottom">
        <h3 class="serif rit-title">{r0.title}</h3>
        <p class="rit-body">{r0.body}</p>
      </div>
    </div>

    <!-- Middle column: two stacked tiles -->
    <div class="rit-col">
      <div class="img img-matcha rit-tile rit-small">
        <img src={r1.photo} alt={r1.alt} class="img-fill" loading="lazy" decoding="async" />
        <div class="rit-shade"></div>
        <div class="rit-chip-tl">
          <span class="chip"><span class={`dot ${r1.dot}`}></span>{r1.time}</span>
        </div>
        <div class="rit-bottom">
          <h3 class="serif rit-title-sm">{r1.title}</h3>
        </div>
      </div>
      <div class="img img-blush rit-tile rit-small">
        <img src={r2.photo} alt={r2.alt} class="img-fill" loading="lazy" decoding="async" />
        <div class="rit-shade"></div>
        <div class="rit-chip-tl">
          <span class="chip"><span class={`dot ${r2.dot}`}></span>{r2.time}</span>
        </div>
        <div class="rit-bottom">
          <h3 class="serif rit-title-sm">{r2.title}</h3>
        </div>
      </div>
    </div>

    <!-- Right big tile: cuchara dulce -->
    <div class="img img-latte rit-tile rit-big">
      <img src={r3.photo} alt={r3.alt} class="img-fill" loading="lazy" decoding="async" />
      <div class="rit-shade"></div>
      <div class="rit-chip-tl">
        <span class="chip"><span class={`dot ${r3.dot}`}></span>{r3.time}</span>
      </div>
      <div class="rit-bottom">
        <h3 class="serif rit-title">{r3.title}</h3>
        <p class="rit-body">{r3.body}</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Mobile: stack everything */
  .rituals-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .rit-tile {
    height: 220px;
    position: relative;
  }
  /* dark gradient at the bottom so the title is always readable over the photo */
  .rit-shade {
    position: absolute;
    inset: 40% 0 0 0;
    background: linear-gradient(to bottom,
      rgba(42, 37, 32, 0) 0%,
      rgba(42, 37, 32, .55) 100%);
    pointer-events: none;
  }
  .rit-tile .rit-chip-tl,
  .rit-tile .rit-bottom { z-index: 2; }
  .rit-tile .rit-title,
  .rit-tile .rit-title-sm { color: var(--cream); }
  .rit-tile .rit-body { color: rgba(246, 239, 227, .85); }
  .rit-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .rit-chip-tl {
    position: absolute;
    top: 18px;
    left: 18px;
  }
  .rit-bottom {
    position: absolute;
    bottom: 22px;
    left: 22px;
    right: 22px;
  }
  .rit-title {
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 300;
    letter-spacing: -.02em;
    margin: 0;
    line-height: 1;
  }
  .rit-title-sm {
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 300;
    letter-spacing: -.02em;
    margin: 0;
    line-height: 1;
  }
  .rit-body {
    font-size: 13px;
    color: var(--ink60);
    max-width: 320px;
    margin-top: 6px;
  }

  @media (min-width: 900px) {
    .rituals-grid {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 18px;
      height: 480px;
    }
    .rit-tile { height: 100%; }
    .rit-col {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .rit-col .rit-tile { flex: 1; }
    .rit-bottom { bottom: 36px; left: 32px; right: 32px; }
  }
</style>
