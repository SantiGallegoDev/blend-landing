---
import logo from '../assets/marca/logo-blend.webp';
import pinkCloud from '../assets/bebidas/pink-cloud/travertino-palmas.png';
import Photo from './Photo.astro';
import { navLinks, waLink } from '../data/site';
import { cartEnabled } from '../data/shop';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const secondary = [
  { label: 'Combos', href: '/combos' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Negocios', href: '/negocios' },
  { label: 'Ayuda', href: '/ayuda' },
];
---
<header class="nav" data-nav>
  <div class="nav-inner container">
    <a href="/" class="nav-logo" aria-label="Blend, ir al inicio">
      <span class="logo" style={`--logo:url(${logo.src})`}></span>
    </a>

    <nav class="nav-links" aria-label="Principal">
      {navLinks.map(({ label, href }) => (
        <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <a class="nav-contact" href={waLink()} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.2 3.6c-.5.4-1.3.1-1.3-.6V16A2.5 2.5 0 0 1 4 13.5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        <span>Escríbenos</span>
      </a>
      {cartEnabled && (
        <a class="nav-cart" href="/carrito" data-cart-link aria-label="Carrito">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 8h13l-1 11.2a2 2 0 0 1-2 1.8h-7a2 2 0 0 1-2-1.8zM9 8V6.5a3 3 0 0 1 6 0V8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
          <span class="nav-cart-count" data-cart-count hidden>0</span>
        </a>
      )}
      <button class="nav-burger" type="button" aria-expanded="false" aria-controls="menu-movil">
        <span class="sr-only" data-label>Abrir menú</span>
        <span class="burger-line burger-top"></span>
        <span class="burger-line burger-bottom"></span>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="menu-movil" hidden>
  <div class="drawer-inner container">
    <div class="drawer-doors">
      <a href="/bebidas" class="drawer-door drawer-door-drinks">
        <span class="drawer-door-img arch">
          <Photo src={pinkCloud} alt="" sizes="40vw" focus="50% 58%" maxWidth={560} />
        </span>
        <span class="drawer-door-label">
          <span class="eyebrow">Blend Drinks</span>
          <span class="drawer-door-title">Bebidas</span>
        </span>
      </a>
      <a href="/digital" class="drawer-door drawer-door-digital">
        <span class="drawer-door-book" aria-hidden="true">
          <span class="mini-book"></span>
        </span>
        <span class="drawer-door-label">
          <span class="eyebrow">Blend Digital</span>
          <span class="drawer-door-title">E-books</span>
        </span>
      </a>
    </div>
    <ul class="drawer-links">
      {secondary.map(({ label, href }) => (
        <li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a></li>
      ))}
    </ul>
    <a class="btn btn-solid btn-block" href={waLink()} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>
  </div>
</div>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in oklab, var(--warm) 86%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color .4s var(--ease), background-color .4s var(--ease);
  }
  .nav[data-scrolled] { border-bottom-color: var(--line); }
  .nav-inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .nav-logo { color: var(--ink); display: block; }
  .nav-logo .logo { height: 30px; }

  .nav-links { display: none; gap: 6px; }
  .nav-links a {
    position: relative;
    padding: 10px 14px;
    font-size: 15px;
    font-weight: 450;
    border-radius: 999px;
    transition: background-color .3s var(--ease);
  }
  .nav-links a:hover { background: var(--cream); }
  .nav-links a[aria-current='page'] { background: var(--cream); }
  .nav-links a[aria-current='page']::after {
    content: '♥';
    position: absolute;
    left: 50%;
    bottom: -6px;
    transform: translateX(-50%);
    font-size: 8px;
  }

  .nav-actions { display: flex; align-items: center; gap: 8px; }
  .nav-contact {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 450;
    transition: border-color .3s var(--ease), background-color .3s var(--ease);
  }
  .nav-contact:hover { border-color: var(--ink); background: var(--cream); }
  .nav-contact svg { width: 18px; height: 18px; }

  .nav-cart {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    transition: background-color .3s var(--ease);
  }
  .nav-cart:hover { background: var(--cream); }
  .nav-cart svg { width: 22px; height: 22px; }
  .nav-cart-count {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--cream);
    font: 500 11px/18px var(--sans);
    text-align: center;
  }
  .nav-cart-count.is-bump { animation: cart-bump .5s var(--ease); }
  @keyframes cart-bump { 40% { transform: scale(1.3); } }

  .nav-burger {
    width: 44px;
    height: 44px;
    display: grid;
    place-content: center;
    gap: 7px;
    border-radius: 999px;
  }
  .burger-line {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--ink);
    transition: transform .4s var(--ease);
  }
  .nav-burger[aria-expanded='true'] .burger-top { transform: translateY(4.25px) rotate(45deg); }
  .nav-burger[aria-expanded='true'] .burger-bottom { transform: translateY(-4.25px) rotate(-45deg); }

  .drawer {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    z-index: 59;
    overflow-y: auto;
    background: var(--warm);
    padding-block: 20px 32px;
  }
  .drawer:not([hidden]) { animation: drawer-in .45s var(--ease); }
  @keyframes drawer-in {
    from { opacity: 0; transform: translateY(-8px); }
  }
  .drawer-inner { display: grid; gap: 28px; }
  .drawer-doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .drawer-door {
    display: grid;
    gap: 14px;
    align-content: space-between;
    min-height: 260px;
    padding: 14px;
    border-radius: var(--r-md);
  }
  .drawer-door-drinks { background: color-mix(in oklab, var(--pink) 18%, var(--cream)); }
  .drawer-door-digital { background: var(--paper); }
  .drawer-door-img {
    --arch-v: 37.5%;
    display: block;
    width: 72%;
    aspect-ratio: 3 / 4;
    margin-inline: auto;
  }
  .drawer-door-book {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 4;
    width: 72%;
    margin-inline: auto;
  }
  .mini-book {
    width: 70%;
    aspect-ratio: 2 / 3;
    border-radius: 3px 8px 8px 3px;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, .18) 0 6%, transparent 6% 100%),
      var(--sage);
    box-shadow: 10px 14px 24px -12px rgba(42, 37, 32, .5);
    transform: rotate(-4deg);
  }
  .drawer-door-label { display: grid; gap: 2px; }
  .drawer-door-title { font-family: var(--serif); font-size: 30px; font-weight: 320; line-height: 1; }
  .drawer-links { display: grid; border-top: 1px solid var(--line); }
  .drawer-links a {
    display: block;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--serif);
    font-size: 26px;
    font-weight: 320;
  }

  @media (min-width: 960px) {
    .nav-links { display: flex; }
    .nav-contact { display: inline-flex; }
    .nav-burger { display: none; }
    .drawer { display: none !important; }
  }
</style>

<script>
  import { cartCount, onCartChange } from '../scripts/cart';

  const nav = document.querySelector<HTMLElement>('[data-nav]');

  // Contador del carrito (solo existe si el carrito está activo).
  const cartLink = document.querySelector<HTMLAnchorElement>('[data-cart-link]');
  const count = cartLink?.querySelector<HTMLElement>('[data-cart-count]');
  if (cartLink && count) {
    const paint = (bump = false) => {
      const n = cartCount();
      count.textContent = String(n);
      count.hidden = n === 0;
      cartLink.setAttribute('aria-label', n ? `Carrito, ${n} ${n === 1 ? 'producto' : 'productos'}` : 'Carrito');
      if (bump && n) {
        count.classList.remove('is-bump');
        void count.offsetWidth;
        count.classList.add('is-bump');
      }
    };
    paint();
    onCartChange(() => paint(true));
  }
  const burger = document.querySelector<HTMLButtonElement>('.nav-burger');
  const drawer = document.getElementById('menu-movil');
  const label = burger?.querySelector<HTMLElement>('[data-label]');

  if (nav) {
    const onScroll = () => nav.toggleAttribute('data-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (burger && drawer) {
    const setOpen = (open: boolean) => {
      drawer.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) drawer.querySelector<HTMLElement>('a')?.focus();
    };
    burger.addEventListener('click', () => setOpen(drawer.hasAttribute('hidden')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hasAttribute('hidden')) {
        setOpen(false);
        burger.focus();
      }
    });
    drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.matchMedia('(min-width: 960px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
