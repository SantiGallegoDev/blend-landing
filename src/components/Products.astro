---
import { products } from '../data/site';
---
<hr class="divider divider-x" />

<section class="section" id="productos">
  <header class="products-head" data-reveal="fade-up">
    <div>
      <div class="eyebrow">Hoy en Blend</div>
      <h2 class="h-section-sm">
        tres pequeños <span class="accent">antojos.</span>
      </h2>
    </div>
    <span class="mono products-count">03 / productos</span>
  </header>

  <div class="products-grid no-scrollbar" data-reveal-grid>
    {products.map((p) => (
      <article class="product-card">
        <div class={`img ${p.img} product-img`}>
          <img src={p.photo} alt={p.alt} class="img-fill" loading="lazy" decoding="async" />
        </div>
        <div class="product-meta">
          <span class="pill-prod">{p.cat}</span>
          <span class="mono product-new">Nuevo</span>
        </div>
        <h3 class="product-name serif">{p.name}</h3>
        <p class="product-tag">{p.tag}</p>
        <div class="product-foot">
          <span class="serif accent product-link">conocer ↗</span>
          <span class="mono product-price">{p.price}</span>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .products-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: clamp(24px, 4vw, 44px);
    gap: 16px;
  }
  .products-count {
    font-size: 12px;
    color: var(--ink60);
    white-space: nowrap;
  }

  /* Mobile: horizontal scroll strip */
  .products-grid {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    padding-bottom: 8px;
    margin-right: calc(var(--pad-x) * -1);
    padding-right: var(--pad-x);
  }
  .product-card {
    background: var(--cream);
    border-radius: 12px;
    padding: 14px;
    border: 1px solid rgba(42, 37, 32, .05);
    flex: 0 0 240px;
    scroll-snap-align: start;
  }
  .product-img {
    aspect-ratio: 4 / 5;
    border-radius: 8px;
  }
  .product-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 18px;
  }
  .product-new {
    font-size: 10px;
    color: var(--ink60);
  }
  .product-name {
    font-size: 30px;
    font-weight: 300;
    margin: 8px 0 4px;
    letter-spacing: -.02em;
    line-height: 1.05;
  }
  .product-tag {
    font-size: 13px;
    color: var(--ink60);
    margin: 0;
    line-height: 1.5;
  }
  .product-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
  }
  .product-link { font-size: 18px; }
  .product-price { font-size: 11px; }

  @media (min-width: 900px) {
    .products-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      overflow: visible;
      margin-right: 0;
      padding-right: 0;
      padding-bottom: 0;
    }
    .product-card {
      padding: 22px;
      border-radius: 14px;
      flex: initial;
    }
    .product-meta { margin-top: 22px; }
    .product-name { font-size: 40px; margin: 12px 0 4px; letter-spacing: -.015em; }
    .product-foot { margin-top: 26px; }
    .product-link { font-size: 22px; }
  }
</style>
