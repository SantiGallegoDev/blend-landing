---
import Photo from './Photo.astro';
import paisaje from '../assets/marca/origen-paisaje-cafetero.png';

interface Props {
  headingLevel?: 'h1' | 'h2';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const top = headingLevel === 'h1';
const enter = (n: number) => (top ? { 'data-rise': String(n) } : { 'data-reveal': 'fade-up' });

const facts = [
  ['Armenia, Quindío', 'origen'],
  ['330 ml', 'cada lata'],
  ['5 sabores', 'dos líneas'],
];
---
<section class="origin section" id="origen" aria-labelledby="origin-title">
  <div class="container origin-inner">
    <div class="origin-art" {...(top ? { 'data-rise': '' } : { 'data-reveal': 'blur-in' })}>
      <Photo src={paisaje} alt="Niebla de la mañana sobre el paisaje cultural cafetero, con palmas de cera" sizes="(min-width: 900px) 50vw, 100vw" />
      <span class="chip origin-chip"><span class="chip-dot" style="--flavor: var(--detox)"></span>4.5339° N · 75.6811° O</span>
    </div>
    <div class="origin-copy">
      <p class="eyebrow" {...enter(2)}>Origen</p>
      <Heading id="origin-title" class:list={[top ? 'h1' : 'h2']} {...enter(3)}>
        Del corazón cafetero, <em>despacio</em> al mundo.
      </Heading>
      <p class="body origin-body" {...enter(4)}>
        Blend nace en Armenia, Quindío, entre montañas verdes y mañanas de niebla.
        Creado con propósito, para ti: bienestar, sabor e historias que nos conectan.
      </p>
      <dl class="origin-facts" data-reveal-children>
        {facts.map(([value, label]) => (
          <div>
            <dt class="eyebrow">{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .origin-inner { display: grid; gap: 40px; align-items: center; }
  .origin-art {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .origin-chip { position: absolute; top: 16px; left: 16px; font-family: var(--mono); font-size: 12px; }
  .origin-copy { display: grid; gap: 18px; justify-items: start; }
  .origin-body { margin-top: 4px; }
  .origin-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
    max-width: 520px;
    margin: 18px 0 0;
  }
  .origin-facts div { border-top: 1px solid var(--line); padding-top: 12px; }
  .origin-facts dt { font-size: 11px; }
  .origin-facts dd {
    margin: 6px 0 0;
    font-family: var(--serif);
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 320;
    line-height: 1.1;
  }

  @media (min-width: 900px) {
    .origin-inner { grid-template-columns: 1.1fr 1fr; gap: 72px; }
  }
</style>
