---
const facts: [string, string][] = [
  ['Quindío',         'origen'],
  ['locales',         'ingredientes'],
  ['en lote pequeño', 'producción'],
];
---
<section class="section" id="origen">
  <div class="origin-inner">
    <div class="origin-art img img-cream" data-reveal="blur-in">
      <img
        src="/images/origin-paisaje-cafetero.png"
        alt="Niebla matinal sobre el paisaje cultural cafetero con palmas de cera"
        class="img-fill"
        loading="lazy"
        decoding="async"
      />
      <div class="origin-coord-chip">
        <span class="chip"><span class="dot"></span>4.5339° N · 75.6811° W</span>
      </div>
    </div>
    <div class="origin-copy">
      <div class="eyebrow" data-reveal="fade-up">Origen · Armenia, Quindío</div>
      <h2 class="h-section" data-reveal="fade-up">
        del <span class="accent">corazón cafetero,</span><br />despacio al mundo.
      </h2>
      <p class="body-lg" style="margin-top: 22px;" data-reveal="fade-up">
        Crecimos entre montañas verdes y mañanas de niebla. Blend nace
        en Armenia, en una cocina pequeña, con frutas del eje cafetero
        y la costumbre de tomarse las cosas sin afán.
      </p>
      <div class="origin-facts" data-reveal-children>
        {facts.map(([n, l]) => (
          <div class="origin-fact">
            <div class="serif" style="font-size: 22px; font-weight: 300;">{n}</div>
            <div class="mono fact-l">{l}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .origin-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
  }
  .origin-art {
    height: clamp(260px, 45vw, 520px);
    position: relative;
  }
  .origin-coord-chip {
    position: absolute;
    top: 18px;
    left: 18px;
  }
  .origin-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 30px;
    max-width: 480px;
  }
  .origin-fact {
    border-top: 1px solid var(--ink12);
    padding-top: 10px;
  }
  .fact-l {
    font-size: 10px;
    color: var(--ink60);
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: .14em;
  }

  @media (min-width: 900px) {
    .origin-inner {
      grid-template-columns: 1fr 1.15fr;
      gap: 64px;
    }
    .origin-coord-chip { top: 24px; left: 24px; }
    .origin-facts { margin-top: 36px; gap: 18px; }
  }
</style>
