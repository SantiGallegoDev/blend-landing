---
import { site } from '../data/site';
const tiles = [
  { cls: 'img-blush',  photo: '/images/ig-01-tres-productos.png',    alt: 'Flat-lay con Pink Cloud, Abrazo Dulce y Spoonables sobre lino rosa' },
  { cls: 'img-cream',  photo: '/images/ig-02-abrazo-dulce.png',      alt: 'Close-up del frasco de Abrazo Dulce sobre travertino crema' },
  { cls: 'img-matcha', photo: '/images/ig-03-pink-cloud-yoga.png',   alt: 'Pink Cloud sobre toalla de yoga verde matcha con bayas' },
  { cls: 'img-latte',  photo: '/images/ig-04-abrazo-toast.png',      alt: 'Tostadas con Abrazo Dulce sobre plato beige junto al frasco' },
  { cls: 'img-berry',  photo: '/images/ig-05-spoonables-macro.png',  alt: 'Macro de la superficie del parfait Spoonables con frambuesa' },
  { cls: 'img-blush',  photo: '/images/product-pink-cloud.png',      alt: 'Pink Cloud sobre travertino bañada en luz cálida' },
];
---
<section class="ig-section">
  <header class="ig-head" data-reveal="fade-up">
    <div>
      <div class="eyebrow">Instagram · @{site.instagram}</div>
      <h2 class="h-section-sm">
        postales de la <span class="accent">semana.</span>
      </h2>
    </div>
    <a class="btn ig-follow" href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener">
      Seguirnos ↗
    </a>
  </header>

  <div class="ig-grid" data-reveal-grid>
    {tiles.map((t) => (
      <a class={`img ${t.cls} ig-tile`} href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener">
        <img src={t.photo} alt={t.alt} class="img-fill" loading="lazy" decoding="async" />
      </a>
    ))}
  </div>

  <a class="btn ig-follow-mobile" href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener">
    Seguirnos ↗
  </a>
</section>

<style>
  .ig-section {
    padding: 0 var(--pad-x) clamp(60px, 8vw, 110px);
  }
  .ig-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
    gap: 16px;
  }
  .ig-follow { display: none; }

  .ig-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .ig-tile { aspect-ratio: 1 / 1; }

  .ig-follow-mobile {
    width: 100%;
    margin-top: 18px;
  }

  @media (min-width: 900px) {
    .ig-grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 10px;
    }
    .ig-head { margin-bottom: 28px; }
    .ig-follow { display: inline-flex; }
    .ig-follow-mobile { display: none; }
  }
</style>
