---
const stats: [string, string][] = [
  ['82',   'kcal'],
  ['0g',   'azúcar añadido'],
  ['100%', 'natural'],
];
---
<section class="spotlight">
  <div class="spotlight-inner">
    <div class="spotlight-copy">
      <div class="eyebrow eyebrow-dark" data-reveal="fade-up">Editorial · Pink Cloud</div>
      <h2 class="h-section-lg" data-reveal="fade-up">
        un cielo<br />en la <span class="accent">mano.</span>
      </h2>
      <p class="spotlight-body" data-reveal="fade-up">
        Agua de coco, fresa y pitahaya — colada lento, sin azúcar añadido.
        Una bebida para llevar al estudio, al café, al sofá. A la mañana
        que no quiere apurarse.
      </p>
      <div class="spotlight-stats" data-reveal-children>
        {stats.map(([n, l]) => (
          <div>
            <div class="stat-n serif">{n}</div>
            <div class="stat-l mono">{l}</div>
          </div>
        ))}
      </div>
    </div>
    <div class="spotlight-art" data-reveal="fade-right">
      <div class="img img-pink-full breath-tilt">
        <img
          src="/images/spotlight-pink-cloud.png"
          alt="Botella Pink Cloud sobre lino blush con luz dorada de fondo"
          class="img-fill"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .spotlight {
    background: var(--blush);
    padding: clamp(60px, 9vw, 120px) var(--pad-x);
    margin-top: 30px;
    position: relative;
    overflow: hidden;
  }
  .spotlight-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  .eyebrow-dark { color: rgba(42, 37, 32, .55); }

  .spotlight-body {
    font-size: clamp(14px, 1.4vw, 16px);
    line-height: 1.7;
    max-width: 460px;
    margin-top: 24px;
    color: rgba(42, 37, 32, .7);
  }
  .spotlight-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: clamp(26px, 4vw, 40px);
    max-width: 480px;
  }
  .stat-n {
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 300;
    line-height: 1;
  }
  .stat-l {
    font-size: 10px;
    color: var(--ink60);
    margin-top: 6px;
    text-transform: uppercase;
    letter-spacing: .15em;
  }
  .spotlight-art {
    position: relative;
    height: clamp(320px, 50vw, 560px);
  }
  .spotlight-art .img {
    position: absolute;
    inset: 0;
    border-radius: 12px;
  }

  @media (min-width: 900px) {
    .spotlight-inner {
      grid-template-columns: 1fr 1.1fr;
      gap: 64px;
    }
  }
</style>
