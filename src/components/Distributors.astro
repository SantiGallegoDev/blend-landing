---
import { stockists, placeTags, site, waLink } from '../data/site';

const fields = [
  { name: 'nombre', label: 'Tu nombre', autocomplete: 'name' },
  { name: 'lugar', label: 'Lugar o negocio', autocomplete: 'organization' },
  { name: 'ciudad', label: 'Ciudad', autocomplete: 'address-level2' },
  { name: 'mensaje', label: 'Cuéntanos en una línea', autocomplete: 'off' },
] as const;
---
<section class="dist section" aria-labelledby="dist-title">
  <div class="container dist-grid">
    <div class="dist-copy">
      <p class="eyebrow" data-rise>Negocios · cafés · estudios</p>
      <h1 id="dist-title" class="h1" data-rise="2">¿Llevamos Blend a <em>tu lugar</em>?</h1>
      <p class="body" data-rise="3">
        Empezamos por el Eje Cafetero (Armenia, Pereira y Manizales) y vamos despacio
        hacia Bogotá y Medellín. Trabajamos con cafés de barrio, estudios de yoga,
        gimnasios boutique y tiendas pequeñas. Si tu lugar se siente como Blend, queremos conocerlo.
      </p>
      <ul class="dist-tags" data-rise="4">
        {placeTags.map((t) => <li class="chip">{t}</li>)}
      </ul>

      <div class="stockists" data-rise="5">
        <p class="eyebrow">Ya nos encuentras en</p>
        <ul>
          {stockists.map(([n, name, where]) => (
            <li>
              <span class="mono stockist-n">{n}</span>
              <span class="stockist-name">{name}</span>
              <span class="small">{where}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <form class="dist-form" data-dist-form data-email={site.email} data-rise="3">
      <p class="eyebrow">Escríbenos</p>
      {fields.map((f) => (
        <label class="dist-field">
          <span>{f.label}</span>
          <input type="text" name={f.name} required autocomplete={f.autocomplete} />
        </label>
      ))}
      <div class="dist-actions">
        <button class="btn btn-solid" type="submit">Enviar por correo</button>
        <a class="btn" href={waLink('Hola Blend, tenemos un lugar y queremos llevar Blend.')} target="_blank" rel="noopener" data-dist-wa>
          Prefiero WhatsApp
        </a>
      </div>
      <p class="small">Respondemos en 48 horas. Al enviar se abre tu aplicación de correo con el mensaje listo.</p>
    </form>
  </div>
</section>

<style>
  .dist-grid { display: grid; gap: 48px; align-items: start; }
  .dist-copy { display: grid; gap: 20px; justify-items: start; }
  .dist-copy .h1 { max-width: 12ch; }
  .dist-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .stockists { width: 100%; margin-top: 12px; padding-top: 20px; border-top: 1px solid var(--line); }
  .stockists ul { display: grid; margin-top: 12px; }
  .stockists li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }
  .stockist-n { font-size: 12px; color: var(--ink-2); }
  .stockist-name { flex: 1; font-family: var(--serif); font-size: 22px; font-weight: 320; }

  .dist-form {
    display: grid;
    gap: 22px;
    padding: clamp(24px, 4vw, 44px);
    border-radius: var(--r-lg);
    background: var(--cream);
  }
  .dist-field { display: grid; gap: 6px; }
  .dist-field span { font-size: 14px; font-weight: 500; }
  .dist-field input {
    width: 100%;
    min-height: 48px;
    padding: 10px 2px;
    border: 0;
    border-bottom: 1px solid rgba(42, 37, 32, .35);
    background: transparent;
    font: 400 18px/1.3 var(--sans);
    color: var(--ink);
    transition: border-color .3s var(--ease);
  }
  .dist-field input:focus { outline: none; border-bottom: 2px solid var(--ink); }
  .dist-field input:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  .dist-actions { display: flex; flex-wrap: wrap; gap: 12px; }

  @media (min-width: 900px) {
    .dist-grid { grid-template-columns: 1fr 1fr; gap: 80px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-dist-form]').forEach((form) => {
    const compose = () => {
      const data = new FormData(form);
      const get = (k: string) => String(data.get(k) ?? '').trim();
      return [
        'Hola Blend, me gustaría llevar sus productos.',
        '',
        `Nombre: ${get('nombre')}`,
        `Lugar o negocio: ${get('lugar')}`,
        `Ciudad: ${get('ciudad')}`,
        `En una línea: ${get('mensaje')}`,
      ].join('\n');
    };
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const subject = encodeURIComponent('Distribuidor Blend');
      window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${encodeURIComponent(compose())}`;
    });
    const wa = form.querySelector<HTMLAnchorElement>('[data-dist-wa]');
    wa?.addEventListener('click', () => {
      if (!form.querySelector<HTMLInputElement>('input')?.value) return;
      wa.href = `${wa.href.split('?')[0]}?text=${encodeURIComponent(compose())}`;
    });
  });
</script>
