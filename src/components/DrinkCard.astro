---
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';
import { drinkLines, formatCOP } from '../data/site';

interface Props {
  drink: CollectionEntry<'bebidas'>;
  sizes?: string;
  headingLevel?: 'h2' | 'h3';
}

const { drink, sizes = '(min-width: 1100px) 22vw, (min-width: 700px) 30vw, 70vw', headingLevel = 'h3' } = Astro.props;
const d = drink.data;
const Heading = headingLevel;
---
<article
  class="drink-card flavored"
  style={`--flavor:${d.flavor}`}
  data-flavor={d.flavor}
  data-line={d.line}
>
  <a href={`/bebidas/${drink.id}`} class="drink-card-link">
    <div class:list={['drink-card-media', 'arch', { 'is-cutout': d.card.fit === 'contain' }]}>
      <Photo
        src={d.card.src}
        alt={d.card.alt}
        focus={d.card.focus}
        fit={d.card.fit}
        sizes={sizes}
        maxWidth={900}
        transitionName={`bebida-${drink.id}`}
      />
    </div>
    <div class="drink-card-body">
      <span class="eyebrow">{drinkLines[d.line].name}</span>
      <Heading class="drink-card-name">{d.name}</Heading>
      <p class="drink-card-ingredients">{d.ingredients.join(' · ')}</p>
      <span class="drink-card-foot">
        <span class="link-arrow">Ver bebida</span>
        {d.price && <span class="price">{formatCOP(d.price)}</span>}
      </span>
    </div>
  </a>
</article>

<style>
  .drink-card { height: 100%; }
  .drink-card-link {
    display: flex;
    flex-direction: column;
    gap: 18px;
    height: 100%;
  }
  .drink-card-media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--tint);
    transition: transform .7s var(--ease), box-shadow .7s var(--ease);
  }
  .drink-card-media :global(img) { transition: transform 1.2s var(--ease); }
  .drink-card-media.is-cutout {
    background:
      radial-gradient(60% 50% at 50% 60%, color-mix(in oklab, var(--flavor) 35%, var(--cream)), var(--tint));
  }
  .drink-card-media.is-cutout :global(img) {
    padding: 12% 16% 8%;
    filter: drop-shadow(0 22px 22px rgba(42, 37, 32, .28));
  }
  .drink-card-link:hover .drink-card-media,
  .drink-card-link:focus-visible .drink-card-media {
    transform: translateY(-6px);
    box-shadow: 0 28px 50px -28px color-mix(in oklab, var(--flavor) 70%, var(--ink));
  }
  .drink-card-link:hover .drink-card-media :global(img) { transform: scale(1.04); }

  .drink-card-body { display: grid; gap: 6px; }
  .drink-card-name {
    font-family: var(--serif);
    font-weight: 320;
    font-size: clamp(26px, 2.3vw, 34px);
    line-height: 1.02;
    letter-spacing: -.02em;
  }
  .drink-card-ingredients { font-size: 14px; color: var(--ink-2); line-height: 1.5; }
  .drink-card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
  }
  .drink-card-link:focus-visible { outline-offset: 6px; }
</style>
