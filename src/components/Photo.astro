---
// Imagen optimizada: AVIF/WebP con srcset automático a partir del ancho original.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  class?: string;
  focus?: string;
  fit?: 'cover' | 'contain';
  eager?: boolean;
  transitionName?: string;
  maxWidth?: number;
}

const {
  src,
  alt,
  sizes = '100vw',
  class: className,
  focus = '50% 50%',
  fit = 'cover',
  eager = false,
  transitionName,
  maxWidth = 1600,
} = Astro.props;

const top = Math.min(src.width, maxWidth);
const preset = [360, 560, 800, 1100, 1400];
const widths = [...preset.filter((w) => w < top - 80), top];
// Los recortes con transparencia necesitan PNG como formato de respaldo.
const fallbackFormat = fit === 'contain' ? 'png' : 'jpg';
const style = [
  `object-position:${focus}`,
  transitionName ? `view-transition-name:${transitionName}` : '',
]
  .filter(Boolean)
  .join(';');
---
<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  fallbackFormat={fallbackFormat}
  class:list={[fit === 'contain' ? 'media-contain' : 'media-cover', className]}
  style={style}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  pictureAttributes={{ class: 'pic' }}
/>
