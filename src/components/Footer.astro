---
import { footerCols } from '../data/site';
---
<footer class="site-footer">
  <div class="footer-grid" data-reveal="fade">
    <div class="footer-brand">
      <div class="wordmark footer-wordmark">Blend</div>
      <p class="footer-blurb">
        Wellness sin obsesión. Hecho en Armenia, Quindío,
        con cariño y poca prisa.
      </p>
    </div>
    {footerCols.map(col => (
      <div class="footer-col">
        <div class="eyebrow footer-eyebrow">{col.title}</div>
        <ul class="footer-list">
          {col.items.map(i => <li>{i}</li>)}
        </ul>
      </div>
    ))}
  </div>

  <div class="footer-bottom">
    <span>© Blend · MMXXV</span>
    <span class="footer-tag">respira, despacio.</span>
    <span>Arm · 4.5339° N, 75.6811° W</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--cream);
    padding: clamp(40px, 6vw, 56px) var(--pad-x) 40px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    align-items: start;
  }
  .footer-wordmark {
    font-size: clamp(40px, 5vw, 56px);
  }
  .footer-blurb {
    font-size: 13px;
    opacity: .6;
    margin-top: 14px;
    line-height: 1.6;
    max-width: 300px;
  }
  .footer-eyebrow {
    color: rgba(246, 239, 227, .5);
  }
  .footer-list {
    font-size: 14px;
    line-height: 2;
    opacity: .9;
    margin-top: 14px;
  }
  .footer-list li { letter-spacing: .01em; }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 36px;
    padding-top: 22px;
    border-top: 1px solid rgba(246, 239, 227, .12);
    font-size: 11px;
    opacity: .5;
    letter-spacing: .06em;
  }

  @media (min-width: 760px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 40px;
    }
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      margin-top: 50px;
    }
  }
</style>
