---
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Moments from '../components/Moments.astro';
import BusinessTeaser from '../components/BusinessTeaser.astro';
import { site, seals } from '../data/site';

// Foto de Katherine y Simón: guárdala como src/assets/marca/nosotros-katherine-y-simon.jpg
// (sirve .jpg, .jpeg, .png o .webp). Mientras no exista, se muestra el espacio reservado.
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/marca/nosotros-*.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(found)[0]?.default;

// Texto adaptado de "Quiénes somos" del catálogo Blend (agosto 2026).
const story = [
  'Blend es el reflejo de nuestra historia: de un amor inquebrantable y de la fuerza que nos unió desde el primer instante.',
  'Llevamos más de 5.000 días compartiendo este plano. Días en los que hemos aprendido, crecido y superado juntos. Hoy, con el corazón lleno de gratitud, podemos decir que han sido nuestros mejores días.',
  'Blend es nuestra mezcla perfecta: la unión de dos almas destinadas a caminar juntas, a iluminarse mutuamente y a demostrar que el amor y la fe son la fuerza más poderosa de todas.',
  'Bienvenidos a esta inmersión en el mundo de la alimentación, un viaje de amor, cuidado y transformación. Aquí descubrirás cómo la alimentación puede ser una herramienta poderosa para mejorar la salud y el bienestar de los nuestros, especialmente de quienes, como mi hijo, enfrentan la epilepsia con fe, amor y valentía.',
];

const pillars = [
  {
    title: 'Bienestar',
    body: 'Cuidarse desde la raíz: pocos ingredientes, con nombre propio y sin azúcar añadida.',
  },
  {
    title: 'Sabor',
    body: 'Fruta, raíces y café de especialidad. Porque cuidarnos también es disfrutar.',
  },
  {
    title: 'Historias',
    body: 'Cada lata y cada guía nacen de nuestra historia familiar y de las ganas de compartirla.',
  },
  {
    title: 'Propósito',
    body: 'Lo que tomas y lo que lees, creado con propósito: lo mismo que nos cuida en casa, para ti.',
  },
];
---
<BaseLayout
  title="Nosotros · Katherine y Simón, la historia de Blend"
  description="Blend nace en Armenia, Quindío, de la historia de Katherine y Simón: bebidas en lata sin azúcar añadida y e-books, creados con propósito."
>
  <section class="story" aria-labelledby="story-title">
    <div class="container story-grid">
      <header class="story-head">
        <p class="eyebrow" data-rise>Quiénes somos · {site.city}</p>
        <h1 id="story-title" class="h1 story-title" data-rise="2">Hola. Esto es <em>Blend</em>.</h1>
        <p class="story-claim" data-rise="3">{site.claim}</p>
      </header>

      <figure class="portrait" data-rise="3">
        <div class="portrait-frame arch flavored">
          {portrait ? (
            <Photo
              src={portrait}
              alt={`${site.founders}, fundadores de Blend`}
              eager
              sizes="(min-width: 900px) 42vw, 100vw"
              focus="50% 30%"
            />
          ) : (
            <div class="portrait-empty" role="img" aria-label={`Espacio reservado para la foto de ${site.founders}`}>
              <span class="eyebrow">{site.founders}</span>
              <span class="portrait-hint">Aquí va su foto.</span>
              <span class="mono portrait-path">src/assets/marca/nosotros-katherine-y-simon.jpg</span>
            </div>
          )}
        </div>
        <figcaption class="portrait-caption">
          <span class="chip"><span class="chip-dot" style="--flavor: var(--pink)"></span>{site.founders} · {site.city}</span>
        </figcaption>
      </figure>

      <div class="story-body" data-rise="4">
        {story.map((p) => <p class="story-p">{p}</p>)}
        <p class="story-sign">
          <span class="story-thanks">Gracias por estar aquí.</span>
          <span>Con amor, <strong>{site.founders}</strong>.</span>
        </p>
      </div>
    </div>
  </section>

  <section class="quote" aria-label="Lo que mueve a Blend">
    <div class="container quote-inner">
      <p class="eyebrow" data-reveal="fade-up">Nuestra historia</p>
      <p class="h2 quote-line" data-reveal="fade-up">El amor y la fe son la fuerza <em>más poderosa</em> de todas.</p>
      <p class="lead quote-lead" data-reveal="fade-up">
        Un viaje de amor, cuidado y transformación que empezó en casa, en Armenia, Quindío, y hoy llega a tu mesa.
      </p>
    </div>
  </section>

  <section class="pillars section-sm" aria-labelledby="pillars-title">
    <div class="container">
      <p class="eyebrow" data-reveal="fade-up">Creado con propósito</p>
      <h2 id="pillars-title" class="h2 pillars-h2" data-reveal="fade-up">Lo que nos <em>importa</em>.</h2>
      <ul class="pillars-grid" data-reveal-children>
        {pillars.map((p, i) => (
          <li>
            <span class="mono pillars-n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3">{p.title}</h3>
            <p class="body">{p.body}</p>
          </li>
        ))}
      </ul>
      <div class="seals" data-reveal="fade-up">
        <p class="eyebrow">Wellness Collection · lo que dice cada etiqueta</p>
        <ul class="seals-list" aria-label="Sellos">
          {seals.map((s) => <li class="chip"><span class="chip-dot"></span>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Moments />
  <BusinessTeaser />
</BaseLayout>

<style>
  .story { padding-block: clamp(24px, 4vw, 56px) clamp(48px, 7vw, 96px); }
  .story-grid {
    display: grid;
    grid-template-areas: 'head' 'portrait' 'body';
    gap: 32px;
  }
  .story-head {
    grid-area: head;
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .story-title { max-width: 10ch; }
  .story-claim {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 300;
    line-height: 1.3;
    color: var(--ink-2);
    max-width: 24ch;
  }

  /* Retrato: arco de la marca, con el hueco reservado hasta que llegue la foto. */
  .portrait { grid-area: portrait; margin: 0; display: grid; gap: 14px; justify-items: start; }
  .portrait-frame {
    --flavor: var(--pink);
    --arch-v: 40%;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: var(--tint);
  }
  .portrait-empty {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 10px;
    height: 100%;
    padding: 12%;
    text-align: center;
    background:
      radial-gradient(70% 60% at 50% 85%, var(--tint-strong), transparent 70%),
      radial-gradient(60% 50% at 80% 15%, color-mix(in oklab, var(--sage) 50%, var(--paper)), transparent 70%);
  }
  .portrait-hint {
    font-family: var(--serif);
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -.02em;
  }
  .portrait-path {
    font-size: 11px;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  .story-body {
    grid-area: body;
    display: grid;
    gap: 22px;
    max-width: 62ch;
  }
  .story-p {
    font-family: var(--serif);
    font-size: clamp(19px, 1.7vw, 24px);
    font-weight: 300;
    line-height: 1.42;
    letter-spacing: -.005em;
  }
  .story-p:first-child {
    font-size: clamp(23px, 2.2vw, 30px);
    line-height: 1.3;
  }
  .story-sign {
    display: grid;
    gap: 4px;
    margin-top: 10px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-size: 16px;
    color: var(--ink-2);
  }
  .story-thanks { font-family: var(--serif); font-style: italic; font-size: 20px; }
  .story-sign strong { color: var(--ink); font-weight: 500; }

  .quote {
    padding-block: clamp(56px, 8vw, 112px);
    background: var(--cream);
  }
  .quote-inner {
    display: grid;
    gap: 18px;
    justify-items: center;
    text-align: center;
  }
  .quote-line { max-width: 16ch; }
  .quote-lead { max-width: 46ch; }

  .pillars-h2 { margin: 10px 0 clamp(32px, 5vw, 56px); }
  .pillars-grid { display: grid; gap: 32px; }
  .pillars-grid li {
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .pillars-n { font-size: 13px; color: var(--ink-2); }
  .seals {
    --flavor: var(--pink);
    display: grid;
    gap: 14px;
    margin-top: clamp(40px, 6vw, 72px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .seals-list { display: flex; flex-wrap: wrap; gap: 8px; }

  @media (min-width: 760px) {
    .pillars-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  }
  @media (min-width: 900px) {
    .story-grid {
      grid-template-columns: 6fr 5fr;
      grid-template-areas:
        'head portrait'
        'body portrait';
      column-gap: clamp(48px, 6vw, 88px);
      row-gap: 40px;
      align-items: start;
    }
    .portrait { position: sticky; top: calc(var(--nav-h) + 24px); }
  }
  @media (min-width: 1100px) {
    .pillars-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
