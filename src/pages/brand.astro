---
// Brand board interno (no indexado): referencia rápida del sistema visual v2.
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import EbookCover3D from '../components/EbookCover3D.astro';
import logo from '../assets/marca/logo-blend.webp';
import detox from '../assets/bebidas/detox/travertino-sol.png';
import pink from '../assets/bebidas/pink-cloud/travertino-palmas.png';
import sunset from '../assets/bebidas/sunset/terrazo-durazno.png';
import latte from '../assets/bebidas/latte-ice/lino-piedra.png';
import detoxIng from '../assets/bebidas/detox/bodegon-ingredientes.png';
import paisaje from '../assets/marca/origen-paisaje-cafetero.png';

type Sw = { hex: string; name: string; note: string };
const base: Sw[] = [
  { hex: '#FBF7EF', name: 'Warm', note: 'lienzo' },
  { hex: '#F6EFE3', name: 'Cream', note: 'superficies' },
  { hex: '#E5D6BF', name: 'Latte', note: 'calidez' },
  { hex: '#2A2520', name: 'Ink', note: 'texto y botones' },
];
const flavors: Sw[] = [
  { hex: '#CAC05F', name: 'Detox', note: 'lima' },
  { hex: '#DC4981', name: 'Pink Cloud', note: 'magenta' },
  { hex: '#EA8B15', name: 'Sunset', note: 'naranja' },
  { hex: '#CBA781', name: 'Latte Ice', note: 'caramelo' },
  { hex: '#704B3F', name: 'Americano Ice', note: 'espresso' },
];
const digital: Sw[] = [
  { hex: '#F3EEE4', name: 'Paper', note: 'fondo Digital' },
  { hex: '#C5D1B0', name: 'Sage', note: 'acento Digital' },
  { hex: '#3F4B37', name: 'Sage ink', note: 'texto sobre salvia' },
];
const voice = [
  'Cercana y clara: dice qué es, qué lleva y cómo se compra.',
  'Invita a explorar; nunca presiona.',
  'Solo afirma lo que dice la etiqueta.',
  'Español primero. Los nombres de producto se quedan como están.',
  'Bienestar sin obsesión: rico, tranquilo, sin reglas imposibles.',
];
const motion = [
  'Entradas suaves al hacer scroll (fade-up, 1 s, out-expo).',
  'Latas flotando en capas que siguen al puntero.',
  'Libros en CSS 3D que giran unos grados.',
  'El fondo toma el color del sabor que exploras.',
  'Todo se detiene con "reducir movimiento".',
];
const photos = [
  { src: detox, alt: 'Detox', focus: '50% 50%' },
  { src: pink, alt: 'Pink Cloud', focus: '50% 58%' },
  { src: sunset, alt: 'Sunset', focus: '69% 50%' },
  { src: latte, alt: 'Latte Ice', focus: '66% 50%' },
  { src: detoxIng, alt: 'Ingredientes de Detox', focus: '70% 50%' },
  { src: paisaje, alt: 'Paisaje cafetero', focus: '50% 50%' },
];
---
<BaseLayout title="Blend · Brand board v2" description="Sistema visual de Blend: líquido y papel." noindex chrome={false}>
  <div class="board container">
    <a href="/" class="eyebrow board-back">← Volver al sitio</a>

    <header class="board-head">
      <span class="logo board-logo" style={`--logo:url(${logo.src})`} role="img" aria-label="Blend"></span>
      <div>
        <p class="eyebrow">Dirección creativa · v2</p>
        <h1 class="h1">Líquido y <em>papel</em>.</h1>
        <p class="lead">
          Blend Drinks vive en el color de cada sabor y en formas de arco. Blend Digital vive en el papel,
          la tinta y la profundidad de un libro. Las dos líneas comparten logo, tipografía, retícula y movimiento.
        </p>
      </div>
    </header>

    <section class="board-sec">
      <p class="eyebrow">01 · Base</p>
      <ul class="sw-grid">
        {base.map((s) => (
          <li><span class="sw" style={`background:${s.hex}`}></span><span class="mono sw-hex">{s.hex}</span><span class="sw-name">{s.name}</span><span class="small">{s.note}</span></li>
        ))}
      </ul>
    </section>

    <section class="board-sec">
      <p class="eyebrow">02 · Colores de sabor (muestreados del líquido real)</p>
      <ul class="sw-grid">
        {flavors.map((s) => (
          <li><span class="sw" style={`background:${s.hex}`}></span><span class="mono sw-hex">{s.hex}</span><span class="sw-name">{s.name}</span><span class="small">{s.note}</span></li>
        ))}
      </ul>
    </section>

    <section class="board-sec">
      <p class="eyebrow">03 · Blend Digital</p>
      <div class="board-digital">
        <ul class="sw-grid">
          {digital.map((s) => (
            <li><span class="sw" style={`background:${s.hex}`}></span><span class="mono sw-hex">{s.hex}</span><span class="sw-name">{s.name}</span><span class="small">{s.note}</span></li>
          ))}
        </ul>
        <div class="board-book" data-tilt><EbookCover3D title="Guías para tu día a día" size="md" float /></div>
      </div>
    </section>

    <section class="board-sec board-trio">
      <div>
        <p class="eyebrow">04 · Tipografía</p>
        <p class="type-display">Bienestar que se <em>toma</em>.</p>
        <p class="mono small">Newsreader 300 + itálica · titulares en tipo oración</p>
        <p class="type-body">Piña, hierbabuena, apio, pepino y limón, con vitamina C.</p>
        <p class="mono small">Outfit 400 · cuerpo · 500 en botones</p>
        <p class="eyebrow">330 ml · Flow</p>
        <p class="mono small">JetBrains Mono · solo precios y metadatos</p>
      </div>
      <div>
        <p class="eyebrow">05 · Voz</p>
        <ul class="heart-list body">{voice.map((v) => <li>{v}</li>)}</ul>
      </div>
      <div>
        <p class="eyebrow">06 · Movimiento</p>
        <ul class="heart-list body">{motion.map((v) => <li>{v}</li>)}</ul>
      </div>
    </section>

    <section class="board-sec">
      <p class="eyebrow">07 · Fotografía</p>
      <ul class="photo-grid">
        {photos.map((p, i) => (
          <li class:list={[{ arch: i < 4 }]}>
            <Photo src={p.src} alt={p.alt} focus={p.focus} sizes="(min-width: 900px) 30vw, 50vw" maxWidth={800} />
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .board { padding-block: 32px 96px; display: grid; gap: 56px; }
  .board-back { text-decoration: underline; text-underline-offset: 4px; }
  .board-head { display: grid; gap: 32px; }
  .board-head .lead { margin-top: 18px; max-width: 60ch; }
  .board-logo { width: min(320px, 70%); color: var(--ink); }
  .board-sec { display: grid; gap: 20px; padding-top: 24px; border-top: 1px solid var(--line); }

  .sw-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 18px; }
  .sw-grid li { display: grid; gap: 4px; }
  .sw { height: 96px; border-radius: var(--r-sm); box-shadow: inset 0 0 0 1px var(--line); margin-bottom: 8px; }
  .sw-hex { font-size: 12px; color: var(--ink-2); }
  .sw-name { font-family: var(--serif); font-size: 22px; font-weight: 320; }

  .board-digital { display: grid; gap: 32px; align-items: center; }
  .board-book { display: grid; place-items: center; min-height: 320px; background: var(--paper); border-radius: var(--r-lg); }

  .board-trio { gap: 40px; }
  .board-trio > div { display: grid; gap: 12px; align-content: start; }
  .type-display { font-family: var(--serif); font-weight: 300; font-size: clamp(40px, 5vw, 64px); line-height: 1; letter-spacing: -.03em; margin-top: 8px; }
  .type-body { font-size: 18px; margin-top: 12px; }

  .photo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .photo-grid li { aspect-ratio: 4 / 5; border-radius: var(--r-md); overflow: hidden; }
  .photo-grid li:nth-child(n+5) { grid-column: span 2; aspect-ratio: 16 / 9; }

  @media (min-width: 900px) {
    .board-head { grid-template-columns: 320px 1fr; align-items: center; }
    .board-digital { grid-template-columns: 1fr 1fr; }
    .board-trio { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .photo-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .photo-grid li:nth-child(n+5) { grid-column: span 2; }
  }
</style>
