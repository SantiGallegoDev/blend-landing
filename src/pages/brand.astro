---
import BaseLayout from '../layouts/BaseLayout.astro';

type Sw = { hex: string; name: string; note: string };
const palette: Sw[] = [
  { hex: '#FBF7EF', name: 'Warm White',   note: 'lienzo' },
  { hex: '#F6EFE3', name: 'Cream',        note: 'superficie primaria' },
  { hex: '#E5D6BF', name: 'Latte',        note: 'calidez, profundidad' },
  { hex: '#EFD3CE', name: 'Blush Cloud',  note: 'acento femenino' },
  { hex: '#C5D1B0', name: 'Soft Matcha',  note: 'señal calma' },
  { hex: '#9F5868', name: 'Muted Berry',  note: 'contraste / CTA' },
];

const voice = [
  'poética, nunca exigente',
  'español ⟷ inglés, con suavidad',
  'dice despacio, no rutina',
  'invita; nunca instruye',
  'dulzura sin culpa',
];

type Mood = { cls: string; cap: string; photo?: string; alt?: string };
const mood: Mood[] = [
  { cls: 'img-blush',  cap: 'vidrio · luz', photo: '/images/spotlight-pink-cloud.png', alt: 'Macro de la botella Pink Cloud con luz dorada' },
  { cls: 'img-cream',  cap: 'niebla · finca quindío' },
  { cls: 'img-matcha', cap: 'macro · espuma' },
  { cls: 'img-latte',  cap: 'light leak' },
  { cls: 'img-berry',  cap: 'frutos · cuchara' },
];
---
<BaseLayout
  title="Blend — Atelier de Latte · Brand board"
  description="Creative direction para Blend — paleta, tipografía, voz y dirección de movimiento."
>
  <div class="brand-frame">
    <a href="/" class="brand-back eyebrow">← volver al sitio</a>

    <article class="brand-board">
      <header class="brand-head">
        <div>
          <div class="eyebrow">Propuesta · creative direction</div>
          <h1 class="brand-title serif">
            Atelier <span class="accent">de</span> Latte
          </h1>
          <p class="brand-lede">
            Un mundo de wellness suave para Blend — texturas de café boutique,
            la contención del skincare, y la calma sin prisa de un estudio
            de yoga. Hecho en Armenia, Quindío.
          </p>
        </div>
        <div class="brand-north">
          <div class="eyebrow">Norte emocional</div>
          <div class="brand-north-quote serif">
            "healthy can feel <span class="accent">soft.</span>"
          </div>
        </div>
      </header>

      <hr class="divider" />

      <div class="eyebrow brand-section-label">01 · Paleta — cálida, lechosa, baja saturación</div>
      <div class="palette-grid">
        {palette.map(s => (
          <div class="sw">
            <div class="sw-chip" style={`background: ${s.hex};`}></div>
            <div class="mono sw-hex">{s.hex}</div>
            <div class="serif sw-name">{s.name}</div>
            <div class="sw-note">{s.note}</div>
          </div>
        ))}
      </div>

      <div class="brand-trio">
        <div>
          <div class="eyebrow">02 · Tipografía</div>
          <div class="serif type-display">respira</div>
          <div class="mono type-meta">Newsreader · light 300 · -1% tracking</div>
          <div style="height: 18px;"></div>
          <div class="type-body">Pink Cloud — agua de coco rosada</div>
          <div class="mono type-meta">Outfit · light 300 · sentence case</div>
          <div style="height: 14px;"></div>
          <div class="mono type-label">VOL · 01 · DULCE MAÑANA</div>
        </div>

        <div>
          <div class="eyebrow">03 · Voz</div>
          <ul class="voice-list">
            {voice.map(v => <li>— {v}</li>)}
          </ul>
        </div>

        <div>
          <div class="eyebrow">04 · Movimiento + imagen</div>
          <p class="motion-copy">
            Fade-ups lentos en scroll · parallax sutil en bodegones · easing 600ms.
            Macro de espuma, condensación, dobleces de lino, mármol. Manos al sol.
            Grano pastel; nunca alta saturación. Un gesto humano por escena.
          </p>
        </div>
      </div>

      <div class="mood-grid">
        {mood.map(m => (
          <div class={`img ${m.cls} mood-tile`}>
            {m.photo && <img src={m.photo} alt={m.alt} class="img-fill" loading="lazy" decoding="async" />}
            <div class="img-cap">{m.cap}</div>
          </div>
        ))}
      </div>
    </article>
  </div>

  <style>
    .brand-frame {
      min-height: 100vh;
      padding: 24px;
      background: var(--cream);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
    .brand-back {
      align-self: flex-start;
      padding: 6px 0;
    }
    .brand-board {
      width: 100%;
      max-width: 1280px;
      min-height: 900px;
      background: var(--warm);
      color: var(--ink);
      padding: clamp(28px, 4vw, 52px) clamp(24px, 5vw, 64px);
      border-radius: 12px;
      box-shadow: 0 1px 0 var(--ink12);
      overflow: hidden;
    }

    .brand-head {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: baseline;
      margin-bottom: 28px;
    }
    .brand-title {
      font-size: clamp(56px, 8vw, 92px);
      line-height: .95;
      margin: 14px 0 0;
      letter-spacing: -.025em;
      font-weight: 300;
    }
    .brand-lede {
      font-size: 15px;
      color: var(--ink60);
      max-width: 460px;
      margin-top: 14px;
      line-height: 1.55;
    }
    .brand-north {
      text-align: left;
    }
    .brand-north-quote {
      font-size: clamp(22px, 2.6vw, 30px);
      line-height: 1.15;
      margin-top: 8px;
      max-width: 340px;
      font-weight: 300;
    }

    .brand-section-label { margin: 28px 0 16px; }

    .palette-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }
    .sw-chip {
      height: 110px;
      border-radius: 8px;
      margin-bottom: 10px;
      box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .04);
    }
    .sw-hex {
      font-size: 10px;
      color: var(--ink60);
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .sw-name {
      font-size: 22px;
      line-height: 1.1;
      margin-top: 4px;
      font-weight: 300;
    }
    .sw-note {
      font-size: 11px;
      color: var(--ink60);
      margin-top: 2px;
    }

    .brand-trio {
      display: grid;
      grid-template-columns: 1fr;
      gap: 36px;
      margin-top: 36px;
    }
    .type-display {
      font-size: clamp(48px, 8vw, 76px);
      line-height: .95;
      font-weight: 300;
    }
    .type-meta {
      font-size: 10px;
      color: var(--ink60);
      margin-top: 4px;
    }
    .type-body {
      font-size: 22px;
      font-weight: 300;
      letter-spacing: .02em;
    }
    .type-label {
      font-size: 11px;
      color: var(--ink60);
      letter-spacing: .18em;
      text-transform: uppercase;
    }
    .voice-list {
      font-size: 14px;
      line-height: 1.9;
    }
    .motion-copy {
      font-size: 13px;
      line-height: 1.7;
      color: var(--ink60);
      margin: 0;
    }

    .mood-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      height: auto;
      margin-top: 28px;
    }
    .mood-tile {
      height: 150px;
    }

    @media (min-width: 700px) {
      .palette-grid { grid-template-columns: repeat(3, 1fr); }
      .brand-trio   { grid-template-columns: 1.3fr 1fr; gap: 36px; }
      .mood-grid    { grid-template-columns: repeat(5, 1fr); }
      .brand-head   { grid-template-columns: 1.4fr 1fr; }
      .brand-north  { text-align: right; }
      .brand-north-quote { margin-left: auto; }
    }
    @media (min-width: 1000px) {
      .palette-grid { grid-template-columns: repeat(6, 1fr); }
      .brand-trio   { grid-template-columns: 1.3fr 1fr 1fr; }
    }
  </style>
</BaseLayout>
