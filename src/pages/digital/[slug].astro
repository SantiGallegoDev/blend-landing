---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EbookCover3D from '../../components/EbookCover3D.astro';
import EbookCard from '../../components/EbookCard.astro';
import DigitalHowTo from '../../components/DigitalHowTo.astro';
import Photo from '../../components/Photo.astro';
import { getEbooks } from '../../data/catalog';
import { site, formatCOP, waLink } from '../../data/site';

export const getStaticPaths = (async () => {
  const ebooks = await getEbooks();
  return ebooks.map((ebook) => ({ params: { slug: ebook.id }, props: { ebook, ebooks } }));
}) satisfies GetStaticPaths;

const { ebook, ebooks } = Astro.props;
const e = ebook.data;
const others = ebooks.filter((x) => x.id !== ebook.id).slice(0, 3);
const meta = [e.pages ? `${e.pages} páginas` : null, e.format].filter(Boolean);

const faq = [
  ...e.faq,
  {
    q: '¿Cómo lo recibo?',
    a: site.checkoutEnabled
      ? 'Cuando Mercado Pago confirma el pago, te enviamos un correo con un enlace para descargarlo.'
      : 'Por ahora coordinamos la compra por WhatsApp. Muy pronto podrás pagarlo aquí y recibirlo automáticamente en tu correo.',
  },
  {
    q: '¿Puedo leerlo en el teléfono?',
    a: `Sí. El formato ${e.format} se abre en el teléfono, la tablet o el computador.`,
  },
].filter((item, i, arr) => arr.findIndex((x) => x.q === item.q) === i);

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: e.title,
  description: e.summary,
  brand: { '@type': 'Brand', name: 'Blend' },
  category: 'E-book',
};
if (e.price) {
  jsonLd.offers = { '@type': 'Offer', price: e.price, priceCurrency: 'COP', availability: 'https://schema.org/InStock' };
}
---
<BaseLayout
  title={`${e.title} · Blend Digital`}
  description={e.summary}
  jsonLd={e.draft ? undefined : jsonLd}
  noindex={e.draft}
>
  <article class="eb">
    <section class="eb-hero">
      <div class="container eb-hero-grid">
        <div class="eb-art" data-tilt>
          <EbookCover3D
            title={e.title}
            subtitle={e.subtitle}
            cover={e.cover}
            color={e.coverColor}
            ink={e.coverInk}
            size="lg"
            float
            transitionName={`ebook-${ebook.id}`}
          />
        </div>
        <div class="eb-buy">
          <nav class="eb-crumbs" aria-label="Ruta">
            <a href="/digital">Blend Digital</a>
            <span aria-hidden="true">/</span>
            <span>E-book</span>
          </nav>
          {e.draft && <span class="badge-draft">Borrador · contenido de ejemplo</span>}
          <h1 class="h1 eb-title">{e.title}</h1>
          {e.subtitle && <p class="eb-subtitle"><em>{e.subtitle}</em></p>}
          <p class="body">{e.summary}</p>
          <ul class="eb-meta">
            {meta.map((m) => <li class="chip">{m}</li>)}
            <li class="chip">Entrega digital</li>
          </ul>
          {e.price && <p class="price eb-price">{formatCOP(e.price)}</p>}
          <div class="eb-actions">
            {site.checkoutEnabled ? (
              <button class="btn btn-solid" type="button" disabled>Comprar e-book</button>
            ) : (
              <a class="btn btn-solid" href={waLink(`Hola Blend, me interesa el e-book "${e.title}".`)} target="_blank" rel="noopener">
                Pedir por WhatsApp
              </a>
            )}
            <a class="link-arrow" href="#que-incluye">Ver qué incluye</a>
          </div>
        </div>
      </div>
    </section>

    <section class="container section-sm eb-content">
      {e.includes.length > 0 && (
        <div class="eb-block" id="que-incluye">
          <p class="eyebrow">Qué incluye</p>
          <ul class="heart-list eb-includes">
            {e.includes.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      )}
      {e.toc.length > 0 && (
        <div class="eb-block">
          <p class="eyebrow">Índice</p>
          <details class="eb-toc" open>
            <summary>{e.toc.length} capítulos</summary>
            <ol>
              {e.toc.map((t, i) => (
                <li><span class="mono">{String(i + 1).padStart(2, '0')}</span>{t}</li>
              ))}
            </ol>
          </details>
        </div>
      )}
    </section>

    {e.samples.length > 0 && (
      <section class="container section-sm" aria-labelledby="samples-title">
        <h2 id="samples-title" class="h3">Algunas páginas</h2>
        <ul class="eb-samples">
          {e.samples.map((s) => (
            <li><Photo src={s.src} alt={s.alt} fit="contain" sizes="(min-width: 900px) 30vw, 80vw" maxWidth={1100} /></li>
          ))}
        </ul>
      </section>
    )}

    <section class="container section-sm">
      <DigitalHowTo />
    </section>

    <section class="container section-sm eb-faq" aria-labelledby="faq-title">
      <h2 id="faq-title" class="h3">Preguntas frecuentes</h2>
      <div class="eb-faq-list">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p class="body">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    {others.length > 0 && (
      <section class="container section eb-others" aria-labelledby="others-title">
        <h2 id="others-title" class="h2">Otros <em>e-books</em>.</h2>
        <ul class="eb-others-grid">
          {others.map((o) => <li><EbookCard ebook={o} /></li>)}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .eb-hero {
    background:
      radial-gradient(50% 70% at 25% 55%, color-mix(in oklab, var(--sage) 50%, var(--paper)), transparent 70%),
      linear-gradient(var(--paper), var(--paper) 80%, var(--warm));
    padding-block: clamp(32px, 6vw, 88px);
  }
  .eb-hero-grid { display: grid; gap: 48px; align-items: center; }
  .eb-art { display: grid; place-items: center; min-height: 380px; }
  .eb-buy { display: grid; gap: 16px; justify-items: start; }
  .eb-crumbs { display: flex; gap: 8px; font-size: 14px; color: var(--ink-2); }
  .eb-crumbs a { text-decoration: underline; text-underline-offset: 3px; }
  .eb-title { max-width: 14ch; }
  .eb-subtitle {
    font-family: var(--serif);
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 300;
    line-height: 1.25;
    color: var(--sage-ink);
    max-width: 32ch;
  }
  .eb-meta { display: flex; flex-wrap: wrap; gap: 8px; }
  .eb-price { font-size: 20px; }
  .eb-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 6px; }

  .eb-content { display: grid; gap: 48px; }
  .eb-block { display: grid; gap: 18px; align-content: start; }
  .eb-includes { --deep: var(--sage-ink); font-size: 18px; }
  .eb-toc summary {
    cursor: pointer;
    font-weight: 500;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .eb-toc ol { display: grid; }
  .eb-toc li {
    display: flex;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 330;
  }
  .eb-toc li .mono { font-size: 13px; color: var(--ink-2); padding-top: 5px; }

  .eb-samples {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(70vw, 340px);
    gap: 16px;
    overflow-x: auto;
    margin-top: 24px;
    padding-bottom: 12px;
  }
  .eb-samples li {
    aspect-ratio: 3 / 4;
    border-radius: var(--r-md);
    background: var(--paper);
    padding: 16px;
  }

  .eb-faq-list { display: grid; margin-top: 20px; border-top: 1px solid var(--line); }
  .eb-faq-list details { border-bottom: 1px solid var(--line); }
  .eb-faq-list summary {
    cursor: pointer;
    padding: 18px 0;
    font-size: 18px;
    font-weight: 450;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .eb-faq-list summary::-webkit-details-marker { display: none; }
  .eb-faq-list summary::after { content: '+'; font-size: 22px; line-height: 1; transition: rotate .3s var(--ease); }
  .eb-faq-list details[open] summary::after { rotate: 45deg; }
  .eb-faq-list details p { padding-bottom: 18px; }

  .eb-others .h2 { margin-bottom: clamp(28px, 4vw, 48px); }
  .eb-others-grid { display: grid; gap: 40px 24px; }

  @media (min-width: 700px) {
    .eb-others-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 900px) {
    .eb-hero-grid { grid-template-columns: 1fr 1.1fr; gap: 72px; }
    .eb-content { grid-template-columns: 1fr 1fr; gap: 72px; }
  }
  @media (min-width: 1000px) {
    .eb-others-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
