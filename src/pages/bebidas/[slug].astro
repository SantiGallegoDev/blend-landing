---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import PaymentMethods from '../../components/PaymentMethods.astro';
import DrinkCard from '../../components/DrinkCard.astro';
import { getDrinks } from '../../data/catalog';
import { site, drinkLines, formatCOP, perUnit, waLink, type DrinkFormat } from '../../data/site';
import { cartEnabled, comboForDrink, drinkFormats } from '../../data/shop';
import { API_URL } from '../../data/blend-api';

export const getStaticPaths = (async () => {
  const drinks = await getDrinks();
  return drinks.map((drink) => ({ params: { slug: drink.id }, props: { drink, drinks } }));
}) satisfies GetStaticPaths;

const { drink, drinks } = Astro.props;
const d = drink.data;
const line = drinkLines[d.line];
const related = drinks.filter((x) => x.id !== drink.id);

// Presentaciones: variantes y six pack del panel, o las de la línea en site.ts.
const formats = await drinkFormats(drink);
const combo = await comboForDrink(drink);
const first = formats[0];
// Con carrito, el six pack de esta ficha se llena con latas de este sabor.
const canVariant = formats.find((f) => f.id === 'lata')?.variantId ?? first.variantId;
const cart = cartEnabled && !!first.variantId;
const formatLabel = (f: DrinkFormat) => [f.label, f.detail].filter(Boolean).join(' ').toLowerCase();
const message = (qty: number, f: DrinkFormat) => `Hola Blend, quiero pedir ${qty} × ${d.name}, ${formatLabel(f)}.`;
const packNote = formats.find((f) => f.note)?.note;

// "Piña, hierbabuena, apio, pepino y limón, con vitamina C. 330 ml."
const lower = (x: string) => x.charAt(0).toLowerCase() + x.slice(1);
const list = (arr: string[]) => (arr.length > 1 ? `${arr.slice(0, -1).join(', ')} y ${arr.at(-1)}` : arr[0]);
const ingredientsText = list(d.ingredients.map((x, i) => (i === 0 ? x : lower(x))));
const extrasText = d.extras.length > 0 ? `, con ${list(d.extras.map(lower))}` : '';
const sentence = `${ingredientsText}${extrasText}. ${d.volume}.`;

const ogImage = await getImage({ src: d.hero.src, width: 1200, format: 'jpg' });
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.name,
  description: d.seoDescription,
  image: new URL(ogImage.src, Astro.site).toString(),
  brand: { '@type': 'Brand', name: 'Blend' },
  category: `Bebidas · ${line.name}`,
};
if (d.price) {
  jsonLd.offers = {
    '@type': 'Offer',
    price: d.price,
    priceCurrency: 'COP',
    availability: d.available ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  };
}
---
<BaseLayout title={`${d.name} · Blend Drinks`} description={d.seoDescription} image={ogImage.src} jsonLd={jsonLd}>
  <article class="pdp flavored" style={`--flavor:${d.flavor}`}>
    <section class="pdp-hero">
      <div class="container pdp-hero-grid">
        <div class:list={['pdp-media', { 'is-cutout': d.hero.fit === 'contain' }]}>
          <Photo
            src={d.hero.src}
            alt={d.hero.alt}
            focus={d.hero.focus}
            fit={d.hero.fit}
            eager
            sizes="(min-width: 960px) 58vw, 100vw"
            transitionName={`bebida-${drink.id}`}
          />
        </div>

        <div class="pdp-buy">
          <nav class="pdp-crumbs" aria-label="Ruta">
            <a href="/bebidas">Bebidas</a>
            <span aria-hidden="true">/</span>
            <span>{line.name}</span>
          </nav>
          <h1 class="h1 pdp-name">{d.name}</h1>
          <p class="pdp-headline"><em>{d.headline}</em></p>
          <p class="body">{d.description}</p>
          <p class="small">{sentence}</p>
          <ul class="pdp-badges" aria-label="Sellos de la etiqueta">
            {d.badges.map((b) => <li class="chip"><span class="chip-dot"></span>{b}</li>)}
          </ul>

          <div class="pdp-actions" data-order data-name={d.name} data-cart={cart ? 'on' : undefined} data-api={cart ? API_URL : undefined} data-variant={first.variantId}>
            {formats.length > 1 && (
              <fieldset class="formats">
                <legend class="eyebrow">Presentación</legend>
                {formats.map((f, i) => (
                  <label class="format">
                    <input
                      type="radio"
                      name="formato"
                      value={f.id}
                      checked={i === 0}
                      data-price={f.price}
                      data-label={formatLabel(f)}
                      data-variant={f.variantId}
                      data-bundle={f.bundleId}
                      data-units={f.units}
                      data-pick={f.bundleId ? canVariant : undefined}
                    />
                    <span class="format-chip">
                      <span class="format-name">{f.label} <small>{f.detail}</small></span>
                      <span class="format-price">
                        <span class="price">{formatCOP(f.price)}</span>
                        {perUnit(f) && <small class="format-unit">{perUnit(f)}</small>}
                        <small class="format-out" hidden>Agotado</small>
                      </span>
                    </span>
                  </label>
                ))}
              </fieldset>
            )}
            {packNote && (
              <p class="small pdp-pack-note">
                {packNote} <a href={combo ? `/combos#${combo.slug}` : '/combos'}>Combinar sabores</a>
              </p>
            )}

            <p class="pdp-price price" data-total data-unit={first.price} aria-live="polite">{formatCOP(first.price)}</p>

            <div class="pdp-order">
              <div class="qty" role="group" aria-label="Cantidad">
                <button type="button" data-step="-1" aria-label="Quitar una">−</button>
                <output data-qty>1</output>
                <button type="button" data-step="1" aria-label="Agregar una">+</button>
              </div>
              {cart ? (
                <a class="btn btn-solid pdp-cta" href="/carrito" data-wa data-add data-label={formatLabel(first)}>
                  Agregar al carrito
                </a>
              ) : (
                <a
                  class="btn btn-solid pdp-cta"
                  href={waLink(message(1, first))}
                  target="_blank"
                  rel="noopener"
                  data-wa
                  data-label={formatLabel(first)}
                >
                  Comprar
                </a>
              )}
            </div>
            {cart && <p class="small pdp-low" data-low hidden></p>}
            {cart && (
              <p class="small pdp-added" role="status" data-added hidden>
                Listo, quedó en tu carrito. <a href="/carrito" class="link-arrow">Ver carrito</a>
              </p>
            )}
            {cart && (
              <p class="small pdp-wa">
                ¿Prefieres pedir por WhatsApp?{' '}
                <a href={waLink(`Hola Blend, quiero pedir ${d.name}.`)} target="_blank" rel="noopener">Escríbenos al {site.whatsappDisplay}</a>
              </p>
            )}
          </div>
          <ul class="pdp-promise small">
            <li>Entregamos frías en {site.deliveryArea}.</li>
            <li>{site.deliveryNotes[0]}</li>
            <li>Pagas aquí y te escribimos para coordinar la hora de entrega.</li>
          </ul>
          <PaymentMethods size="sm" class="pdp-pay" />
        </div>
      </div>
    </section>

    <div class="buybar" data-buybar aria-hidden="true">
      <div class="container buybar-inner">
        <span class="buybar-name">{d.name}</span>
        <span class="price" data-buybar-total>{formatCOP(first.price)}</span>
        {cart ? (
          <a class="btn btn-solid" href="/carrito" tabindex="-1" data-buybar-cta>Agregar</a>
        ) : (
          <a class="btn btn-solid" href={waLink(message(1, first))} target="_blank" rel="noopener" tabindex="-1" data-buybar-cta>Comprar</a>
        )}
      </div>
    </div>

    <section class="container section-sm pdp-info">
      <div class="pdp-block">
        <p class="eyebrow">Lo que lleva</p>
        <ul class="pdp-ingredients">
          {d.ingredients.map((i) => <li>{i}</li>)}
          {d.extras.map((x) => <li class="pdp-extra">+ {x}</li>)}
        </ul>
      </div>
      <div class="pdp-block">
        <p class="eyebrow">Cómo disfrutarla</p>
        <ul class="heart-list body">
          <li>Guárdala en la nevera, como indica la etiqueta.</li>
          <li>Ábrela fría y tómala directo de la lata o sobre hielo.</li>
          <li>Cada lata trae {d.volume}.</li>
        </ul>
      </div>
    </section>

    {d.gallery.length > 0 && (
      <section class="container pdp-gallery" aria-label="Galería">
        <ul class:list={['pdp-gallery-grid', `count-${d.gallery.length}`]}>
          {d.gallery.map((g) => (
            <li>
              <Photo src={g.src} alt={g.alt} focus={g.focus} fit={g.fit} sizes="(min-width: 900px) 45vw, 100vw" />
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="container section pdp-related" aria-labelledby="related-title">
      <h2 id="related-title" class="h2">También te puede <em>gustar</em>.</h2>
      <ul class="pdp-related-grid">
        {related.map((r) => (
          <li><DrinkCard drink={r} sizes="(min-width: 900px) 22vw, 45vw" /></li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .pdp-hero {
    background: linear-gradient(var(--tint) 0%, var(--tint) 70%, var(--warm) 100%);
    padding-block: clamp(20px, 4vw, 56px) clamp(40px, 6vw, 80px);
  }
  .pdp-hero-grid { display: grid; gap: 32px; align-items: center; }
  .pdp-media {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--tint-strong);
  }
  .pdp-media.is-cutout {
    background: radial-gradient(60% 55% at 50% 60%, var(--tint-strong), var(--tint));
  }
  .pdp-media.is-cutout :global(img) {
    padding: 6% 0;
    filter: drop-shadow(0 30px 30px rgba(42, 37, 32, .3));
  }

  .pdp-buy { display: grid; gap: 16px; justify-items: start; }
  .pdp-crumbs { display: flex; gap: 8px; font-size: 14px; color: var(--ink-2); }
  .pdp-crumbs a { text-decoration: underline; text-underline-offset: 3px; }
  .pdp-headline {
    font-family: var(--serif);
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 300;
    line-height: 1.2;
    color: var(--deep);
  }
  .pdp-badges { display: flex; flex-wrap: wrap; gap: 8px; }

  .pdp-actions {
    display: grid;
    gap: 14px;
    width: 100%;
    max-width: 440px;
    margin-top: 6px;
  }
  .formats { display: grid; gap: 8px; margin: 0; padding: 0; border: 0; min-width: 0; }
  .formats legend { padding: 0; margin-bottom: 6px; }
  .format { position: relative; display: block; }
  .format input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .format-chip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 46px;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, .55);
    cursor: pointer;
    transition: background-color .3s var(--ease), color .3s var(--ease), border-color .3s var(--ease);
  }
  .format-chip:hover { border-color: var(--ink); }
  .format-name { font-weight: 500; }
  .format-name small { font-size: 13px; font-weight: 400; color: var(--ink-2); margin-left: 6px; }
  .format input:checked + .format-chip {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--cream);
  }
  .format input:checked + .format-chip small { color: rgba(246, 239, 227, .75); }
  .format-price { display: grid; justify-items: end; line-height: 1.2; }
  .format-price small { font-size: 12px; color: var(--ink-2); }
  .format.is-soldout .format-chip { opacity: .5; cursor: not-allowed; }
  .format.is-soldout .format-chip:hover { border-color: var(--line); }
  .format.is-soldout .format-unit { display: none; }
  .pdp-low { color: var(--deep); }
  .pdp-cta.is-soldout, .buybar .is-soldout { opacity: .5; pointer-events: none; }
  .format input:focus-visible + .format-chip { outline: 2px solid var(--ink); outline-offset: 3px; }

  .pdp-price { font-size: 20px; }
  .pdp-pack-note a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .pdp-wa a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .pdp-added { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; color: var(--ink); }
  .pdp-added:not([hidden]) { animation: added-in .5s var(--ease); }
  @keyframes added-in { from { opacity: 0; transform: translateY(-4px); } }
  .pdp-order { display: flex; flex-wrap: wrap; gap: 12px; }
  .qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--ink);
    border-radius: 999px;
    min-height: 50px;
  }
  .qty button {
    width: 46px;
    height: 48px;
    font-size: 20px;
    border-radius: 999px;
  }
  .qty button:hover { background: rgba(255, 255, 255, .6); }
  .qty output { min-width: 28px; text-align: center; font-family: var(--mono); font-size: 16px; }
  .pdp-promise {
    display: grid;
    gap: 6px;
    width: 100%;
    max-width: 440px;
    padding-top: 16px;
    border-top: 1px solid color-mix(in oklab, var(--ink) 10%, transparent);
  }
  .pdp-promise li { position: relative; padding-left: 22px; }
  .pdp-buy :global(.pdp-pay) { color: var(--ink-2); }
  .pdp-promise li::before {
    content: '♥';
    position: absolute;
    left: 0;
    top: .15em;
    font-size: 10px;
    color: var(--deep);
  }

  /* Barra de compra fija en móvil: aparece cuando el botón principal sale de pantalla. */
  .buybar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    padding: 10px 0 calc(10px + env(safe-area-inset-bottom));
    background: color-mix(in oklab, var(--warm) 90%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-top: 1px solid var(--line);
    translate: 0 110%;
    transition: translate .5s var(--ease);
  }
  .buybar[data-show] { translate: 0 0; }
  :global(body:has(.buybar)) { padding-bottom: 72px; }
  .buybar-inner { display: flex; align-items: center; gap: 12px; }
  .buybar-name {
    flex: 1;
    min-width: 0;
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 300;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .buybar .btn { min-height: 44px; padding: 0 22px; }

  .pdp-info { display: grid; gap: 40px; }
  .pdp-block { display: grid; gap: 18px; align-content: start; }
  .pdp-ingredients { display: flex; flex-wrap: wrap; gap: 6px 22px; }
  .pdp-ingredients li {
    font-family: var(--serif);
    font-size: clamp(30px, 3.6vw, 52px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -.02em;
  }
  .pdp-ingredients li:has(+ li:not(.pdp-extra))::after {
    content: '·';
    margin-left: 22px;
    color: var(--ink-3);
  }
  .pdp-ingredients .pdp-extra { font-style: italic; color: var(--deep); }

  .pdp-gallery-grid { display: grid; gap: 16px; }
  .pdp-gallery-grid li {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--tint);
  }

  .pdp-related .h2 { margin-bottom: clamp(28px, 4vw, 48px); }
  .pdp-related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 16px;
  }

  @media (min-width: 900px) {
    .pdp-info { grid-template-columns: 1.4fr 1fr; gap: 72px; }
    .pdp-gallery-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
    .pdp-gallery-grid.count-1 { grid-template-columns: minmax(0, 420px); }
    .pdp-gallery-grid.count-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pdp-gallery-grid.count-2 li { aspect-ratio: 4 / 3; }
    .pdp-related-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  }
  @media (min-width: 960px) {
    .buybar { display: none; }
    :global(body:has(.buybar)) { padding-bottom: 0; }
    .pdp-hero-grid { grid-template-columns: 1.35fr 1fr; gap: 64px; }
    .pdp-media { aspect-ratio: 5 / 4; }
  }
</style>

<script>
  import { addBundle, addItem } from '../../scripts/cart';
  import { loadStock, type Stock } from '../../scripts/stock';

  // Cantidad + presentación → precio total y, según el modo, carrito o mensaje de WhatsApp.
  document.querySelectorAll<HTMLElement>('[data-order]').forEach((box) => {
    const out = box.querySelector<HTMLOutputElement>('[data-qty]');
    const link = box.querySelector<HTMLAnchorElement>('[data-wa]');
    const total = box.querySelector<HTMLElement>('[data-total]');
    const radios = [...box.querySelectorAll<HTMLInputElement>('input[name="formato"]')];
    if (!out || !link) return;

    const cartMode = box.dataset.cart === 'on';
    const added = box.querySelector<HTMLElement>('[data-added]');
    const base = link.href.split('?')[0];
    const name = box.dataset.name ?? '';
    const cop = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
    const bar = document.querySelector<HTMLElement>('[data-buybar]');
    const barTotal = bar?.querySelector<HTMLElement>('[data-buybar-total]');
    const barCta = bar?.querySelector<HTMLAnchorElement>('[data-buybar-cta]');
    const low = box.querySelector<HTMLElement>('[data-low]');
    const plus = box.querySelector<HTMLButtonElement>('[data-step="1"]');
    const MAX = 24;
    let stock: Stock | null = null;
    let qty = 1;

    // Cuánto se puede pedir del formato: latas en stock, o cajas completas del sabor.
    const available = (r?: HTMLInputElement) => {
      if (!stock) return MAX;
      if (r?.dataset.bundle) {
        const n = stock[r.dataset.pick ?? ''];
        return n == null ? MAX : Math.floor(n / Number(r.dataset.units ?? 6));
      }
      const n = stock[r?.dataset.variant ?? box.dataset.variant ?? ''];
      return n == null ? MAX : n;
    };

    const update = () => {
      const chosen = radios.find((r) => r.checked);
      const label = chosen?.dataset.label ?? link.dataset.label ?? '';
      const unit = Number(chosen?.dataset.price ?? total?.dataset.unit ?? 0);
      const max = Math.min(MAX, available(chosen));
      qty = Math.max(1, Math.min(qty, max));
      out.value = String(qty);
      if (plus) plus.disabled = qty >= max;
      if (cartMode) {
        const soldOut = max === 0;
        [link, barCta].forEach((el) => {
          if (!el) return;
          el.classList.toggle('is-soldout', soldOut);
          el.toggleAttribute('aria-disabled', soldOut);
        });
        link.textContent = soldOut ? 'Agotado' : 'Agregar al carrito';
        if (barCta) barCta.textContent = soldOut ? 'Agotado' : 'Agregar';
        if (low) {
          low.hidden = !(stock && !chosen?.dataset.bundle && max > 0 && max <= 5);
          low.textContent = max === 1 ? 'Queda 1 lata.' : `Quedan ${max} latas.`;
        }
      }
      if (total && unit) {
        total.textContent = qty > 1 ? `${cop.format(unit * qty)} · ${qty} × ${cop.format(unit)}` : cop.format(unit);
      }
      if (barTotal && unit) barTotal.textContent = cop.format(unit * qty);
      if (cartMode) return;
      const text = `Hola Blend, quiero pedir ${qty} × ${name}, ${label}.`;
      link.href = `${base}?text=${encodeURIComponent(text)}`;
      if (barCta) barCta.href = link.href;
    };

    // Carrito: una variante suelta o tantas cajas como la cantidad, llenas de este sabor.
    const addToCart = (e: Event) => {
      e.preventDefault();
      const chosen = radios.find((r) => r.checked);
      if (available(chosen) === 0) return;
      const bundleId = chosen?.dataset.bundle;
      if (bundleId) {
        const pick = { variantId: chosen!.dataset.pick ?? '', qty: Number(chosen!.dataset.units ?? 6) };
        for (let i = 0; i < qty; i++) addBundle(bundleId, [pick]);
      } else {
        const variantId = chosen?.dataset.variant ?? box.dataset.variant;
        if (variantId) addItem(variantId, qty);
      }
      link.textContent = 'Agregado';
      setTimeout(() => (link.textContent = 'Agregar al carrito'), 1800);
      if (added) added.hidden = false;
    };
    if (cartMode) {
      link.addEventListener('click', addToCart);
      barCta?.addEventListener('click', addToCart);
    }

    // La barra fija aparece solo cuando el botón principal ya quedó arriba, fuera de pantalla.
    if (bar && barCta) {
      new IntersectionObserver(([entry]) => {
        const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        bar.toggleAttribute('data-show', show);
        bar.setAttribute('aria-hidden', String(!show));
        barCta.tabIndex = show ? 0 : -1;
      }).observe(link);
    }

    box.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        qty = Math.max(1, qty + Number(btn.dataset.step));
        update();
      });
    });
    radios.forEach((r) => r.addEventListener('change', update));

    // Stock en vivo: marca formatos agotados y, si el elegido lo está, pasa al primero disponible.
    if (cartMode && box.dataset.api) {
      loadStock(box.dataset.api).then((s) => {
        if (!s) return;
        stock = s;
        radios.forEach((r) => {
          const out = available(r) === 0;
          r.disabled = out;
          r.closest('.format')?.classList.toggle('is-soldout', out);
          r.closest('.format')?.querySelector<HTMLElement>('.format-out')?.toggleAttribute('hidden', !out);
        });
        const chosen = radios.find((r) => r.checked);
        if (chosen?.disabled) {
          const next = radios.find((r) => !r.disabled);
          if (next) next.checked = true;
        }
        update();
      });
    }
  });
</script>
