---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, waLink, instagramUrl, formatCOP, events } from '../data/site';
import { getDrinks } from '../data/catalog';
import { flowFormats } from '../data/shop';

const drinks = await getDrinks();
const flow = await flowFormats();
const lata = flow.find((f) => f.id === 'lata');
const six = flow.find((f) => f.id === 'six');
const litro = flow.find((f) => f.id === 'litro');
const coffee = drinks
  .filter((d) => d.data.line === 'cold-coffee' && d.data.price)
  .map((d) => `${d.data.name} ${formatCOP(d.data.price!)}`)
  .join(' y ');

// Respuestas escritas para la tienda con pago en línea (pasarela activa).
const groups = [
  {
    id: 'bebidas',
    title: 'Bebidas',
    items: [
      {
        q: '¿Cuánto cuestan?',
        a: `En la línea Flow (Detox, Pink Cloud y Sunset) la lata de 330 ml cuesta ${formatCOP(lata!.price)}, el six pack de 6 latas ${formatCOP(six!.price)} y la presentación de 1 litro ${formatCOP(litro!.price)}. En Cold Coffee: ${coffee}.`,
      },
      {
        q: '¿Puedo armar el six pack con varios sabores?',
        a: 'Sí. El six pack Flow lo armas con los sabores que quieras; eliges la combinación antes de agregarlo al carrito.',
      },
      {
        q: '¿Dónde entregan?',
        a: `Entregamos en ${site.deliveryArea}. ${site.deliveryNotes.join(' ')} Si estás en otra ciudad, escríbenos y te contamos.`,
      },
      {
        q: '¿Cómo hago un pedido?',
        a: `Elige tus bebidas, agrégalas al carrito y paga aquí mismo. Después te escribimos para coordinar la hora de entrega. Si prefieres, también puedes pedir por WhatsApp al ${site.whatsappDisplay}.`,
      },
      {
        q: '¿Cómo se conservan?',
        a: 'Mantenlas refrigeradas, como indica la etiqueta, y tómalas frías.',
      },
      {
        q: '¿Qué llevan?',
        a: 'Cada ficha muestra los ingredientes tal como aparecen en la etiqueta. Todas son latas de 330 ml sin azúcar añadida; la línea Flow además es keto friendly y lleva ingredientes 100 % naturales.',
      },
    ],
  },
  {
    id: 'eventos',
    title: 'Eventos',
    items: [
      {
        q: '¿Hacen bebidas personalizadas para eventos?',
        a: `${events.lead} ${events.motto} Cuéntanos tu idea por WhatsApp y te ayudamos a hacerla realidad. ${site.deliveryNotes[1]}`,
      },
    ],
  },
  {
    id: 'e-books',
    title: 'E-books',
    items: [
      { q: '¿En qué formato llegan?', a: 'En PDF, para leer en el teléfono, la tablet o el computador.' },
      {
        q: '¿Cómo los recibo?',
        a: 'Apenas se confirma tu pago, te llega un correo con el enlace para descargarlo.',
      },
      {
        q: '¿Puedo ver el contenido antes de comprar?',
        a: 'Sí. Cada ficha muestra qué incluye el e-book y su índice.',
      },
    ],
  },
  {
    id: 'pagos',
    title: 'Pagos',
    items: [
      {
        q: '¿Cómo puedo pagar?',
        a: 'Con tarjeta débito o crédito (Visa y Mastercard), PSE o Efecty.',
      },
      {
        q: '¿Es seguro pagar aquí?',
        a: 'Sí. El pago se hace en una pasarela certificada: Blend nunca ve ni guarda los datos de tu tarjeta.',
      },
      {
        q: '¿Qué pasa si pago con PSE o Efecty?',
        a: 'El pedido queda reservado mientras se confirma el pago. Con Efecty puede tardar un poco; te avisamos por correo cuando esté listo.',
      },
    ],
  },
];
---
<BaseLayout
  title="Ayuda · Blend"
  description="Preguntas frecuentes sobre precios, entregas, eventos, e-books y pagos en Blend."
>
  <section class="container section help">
    <header class="help-head">
      <p class="eyebrow">Ayuda</p>
      <h1 class="h1">¿En qué te <em>ayudamos</em>?</h1>
      <p class="lead">Si no encuentras tu respuesta, escríbenos y te contestamos.</p>
      <div class="help-contact">
        <a class="btn btn-solid" href={waLink('Hola Blend, tengo una pregunta.')} target="_blank" rel="noopener">WhatsApp {site.whatsappDisplay}</a>
        <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="link-arrow" href={instagramUrl} target="_blank" rel="noopener">@{site.instagram}</a>
      </div>
    </header>

    {groups.map((g) => (
      <section class="help-group" id={g.id} aria-labelledby={`${g.id}-title`}>
        <h2 id={`${g.id}-title`} class="h3">{g.title}</h2>
        <div class="help-list">
          {g.items.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p class="body">{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>

<style>
  .help-head { display: grid; gap: 18px; justify-items: start; margin-bottom: clamp(40px, 6vw, 72px); }
  .help-contact { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 6px; }
  .help-group {
    display: grid;
    gap: 16px;
    padding-block: 32px;
    border-top: 1px solid var(--line);
  }
  .help-list { display: grid; }
  .help-list details { border-bottom: 1px solid var(--line); }
  .help-list summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    font-size: 18px;
    font-weight: 450;
  }
  .help-list summary::-webkit-details-marker { display: none; }
  .help-list summary::after { content: '+'; font-size: 22px; line-height: 1; transition: rotate .3s var(--ease); }
  .help-list details[open] summary::after { rotate: 45deg; }
  .help-list details p { padding-bottom: 20px; }

  @media (min-width: 900px) {
    .help-group { grid-template-columns: 1fr 2fr; gap: 48px; }
  }
</style>
