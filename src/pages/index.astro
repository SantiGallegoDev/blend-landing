---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroEcosystem from '../components/HeroEcosystem.astro';
import DrinkShowcase from '../components/DrinkShowcase.astro';
import SixPack from '../components/SixPack.astro';
import IngredientStory from '../components/IngredientStory.astro';
import Bridge from '../components/Bridge.astro';
import DigitalShowcase from '../components/DigitalShowcase.astro';
import Moments from '../components/Moments.astro';
import HowToOrder from '../components/HowToOrder.astro';
import BusinessTeaser from '../components/BusinessTeaser.astro';
import { site, instagramUrl } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Blend',
  url: Astro.site?.toString(),
  logo: new URL('/og-blend.jpg', Astro.site).toString(),
  sameAs: [instagramUrl],
  address: { '@type': 'PostalAddress', addressLocality: 'Armenia', addressRegion: 'Quindío', addressCountry: 'CO' },
  email: site.email,
  telephone: `+${site.whatsapp}`,
  areaServed: site.deliveryArea,
};
---
<BaseLayout jsonLd={jsonLd}>
  <HeroEcosystem />
  <DrinkShowcase />
  <SixPack />
  <IngredientStory />
  <Bridge />
  <DigitalShowcase />
  <Moments />
  <HowToOrder />
  <BusinessTeaser />
</BaseLayout>
